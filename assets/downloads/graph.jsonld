   "identifier": "SRC-CX-0049",
   "name": "CX-0049 DID Document Schema",
   "publisher": "Catena-X Automotive Network Association",
   "version": "v2.3.0 (preview)"
  },
  {
   "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding",
   "@type": "ebw:Source",
