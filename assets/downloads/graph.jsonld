{
 "@context": {
  "@vocab": "https://schema.org/",
  "ebw": "https://spherity.github.io/business-wallet-requirements/ns#"
 },
 "@graph": [
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-001",
   "name": "Human can deny wallet tool invocations",
   "description": "Where the wallet or an agent exposes wallet functions as MCP tools, the application shall let the user deny each tool invocation that has legal or financial effect, and shall indicate clearly when a tool is invoked.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/server/tools"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-002",
   "name": "Tool annotations treated as untrusted",
   "description": "Where the wallet or an agent acts as an MCP client, it shall treat tool annotations as untrusted unless they come from a trusted server.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/server/tools"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-003",
   "name": "Auth-required state is not itself an authorisation",
   "description": "Where the wallet or an agent implements A2A, the agent shall not treat the TASK_STATE_AUTH_REQUIRED transition, by itself, as authorisation for any operation, and shall define how an authorised operation is identified and checked.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-004",
   "name": "Agents act by delegation, not impersonation",
   "description": "Where the wallet or an agent acts on behalf of a user or legal person, the agent shall use explicit on-behalf-of delegation that proves its delegated scope while remaining identifiable as distinct from the principal.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-005",
   "name": "Agent identity carries model, version and capabilities",
   "description": "Where the wallet or an agent presents an agent identity to a relying party, the identity shall be accompanied by metadata on the underlying model, version and capabilities so that the relying party can apply risk-based access control.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-006",
   "name": "Delegation path verifiable end to end",
   "description": "Where the wallet or an agent delegates sub-tasks to other agents, a resource server at the end of the chain shall be able to cryptographically verify the entire delegation path back to the original principal and each step shall narrow scope.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-007",
   "name": "Autonomous agent actions distinguished from delegated ones",
   "description": "Where the wallet or an agent can act without an attributable upstream principal, such autonomous actions shall be clearly distinguished from delegated actions, for example by separate identities or token scopes.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-wimse-arch/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-008",
   "name": "Each delegation hop scopes and re-binds context",
   "description": "Where the wallet or an agent takes part in a multi-hop chain of agent delegation, each hop shall explicitly scope and re-bind the security context.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-wimse-arch/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-009",
   "name": "Agent DID authentication separate from authorisation",
   "description": "Where the wallet or an agent authenticates with the W3C AI Agent Protocol DID profile, the server shall evaluate its authorisation policy independently after authentication and return an authorisation failure when the DID lacks permission.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://w3c-cg.github.io/ai-agent-protocol/agent-identity.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-010",
   "name": "Agent mandate states principal, agent, scope, limits, validity",
   "description": "An agent mandate shall state the principal, the agent, the scope of permitted actions, the limits on those actions and the validity period.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-011",
   "name": "Agent functions must not weaken core functionalities",
   "description": "Where a provider of European Business Wallets offers agentic AI functionality as an additional functionality, that functionality shall not interfere with or compromise the confidentiality, availability or integrity of the minimum core functionalities.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-012",
   "name": "Agent actions distinguishable in wallet log",
   "description": "The European Business Wallet shall record, for each action performed by an AI agent, the agent identifier and the mandate relied on, so that it is distinguishable from direct user action in the log of transactions.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-013",
   "name": "Agent identified separately from principal",
   "description": "An AI agent acting for an owner shall be identified by an identifier of its own that is distinct from the identifier of the principal and expressed as the actor of the delegation.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc8693"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-014",
   "name": "Agent keys separate from principal credentials",
   "description": "The agent provider shall ensure that an AI agent cannot access, or use without a trusted surface, the signing key used to create mandates for that agent.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-015",
   "name": "Owner identity preserved under delegation",
   "description": "The mandate and authorisation system shall not give an authorised representative or AI agent possession of the owner identification data or the private keys of the owner's wallet unit.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-016",
   "name": "Informed consent on a trusted surface before mandate creation",
   "description": "Before a mandate is created for an AI agent, a trusted surface shall present the mandate content to the principal and obtain the principal's informed consent.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-017",
   "name": "Consent surface not driven by an AI model",
   "description": "The trusted surface that obtains consent for a mandate shall be operated without a non-deterministic AI model handling its communication.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-018",
   "name": "Mandate verification in deterministic code",
   "description": "Validation of mandates and processing of their constraints shall be performed in deterministic code, not by an AI model.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-019",
   "name": "Mandate limits enforced outside the agent",
   "description": "The verifier or the wallet, not the AI agent, shall enforce the limits of a mandate on each action the agent attempts.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-020",
   "name": "Unknown mandate constraints fail evaluation",
   "description": "A verifier shall treat any mandate constraint it does not recognise as failing evaluation.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-021",
   "name": "Cumulative budget across agent actions",
   "description": "When a mandate contains a budget constraint, the verifier shall track the total of previous actions under that mandate and reject an action that would exceed the budget.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-022",
   "name": "No new closed mandate before the previous is resolved",
   "description": "An AI agent shall not present a further closed mandate under the same open mandate before it has received a rejection receipt for the previous one.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-023",
   "name": "Agent discloses only needed mandate content",
   "description": "When presenting a mandate with selective disclosures, the AI agent shall disclose only the parts needed for the verifier to evaluate the closed mandate.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-024",
   "name": "Mandate validity no longer than the task needs",
   "description": "A mandate for an AI agent shall carry an expiry no later than the time needed to complete the assigned task.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-025",
   "name": "Delegation depth bounded by the mandate",
   "description": "A mandate shall state whether the AI agent may sub-delegate and the maximum number of delegation steps, and a verifier shall reject a chain that exceeds it.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-026",
   "name": "Signed receipt for every mandate presentation",
   "description": "Upon accepting or rejecting a presented mandate, the verifier shall return a signed receipt that references a hash of the received mandate.",
   "ebw:category": "AIF",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-027",
   "name": "Non-repudiable evidence of mandate use",
   "description": "The parties to an agent-initiated transaction shall retain the open mandate, the closed mandate and the receipt so that together they can be verified as evidence of what the principal authorised.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-028",
   "name": "Human approval above a mandate-defined threshold",
   "description": "A mandate shall be able to define thresholds or action classes above which the action requires approval by a natural person, and the wallet or verifier shall withhold the action until that approval is given.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-029",
   "name": "AI literacy of staff operating AI systems",
   "description": "The provider and the deployer of an AI system used in or with a business wallet shall take measures to support the development of AI literacy of their staff and other persons dealing with the operation and use of the AI system on their behalf.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-030",
   "name": "Lifecycle risk management system for high-risk AI",
   "description": "The provider of a high-risk AI system shall establish, implement, document and maintain a risk management system as a continuous iterative process over the entire lifecycle of that system.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-031",
   "name": "Risk evaluation includes foreseeable misuse",
   "description": "The provider of a high-risk AI system shall estimate and evaluate the risks that may emerge when the system is used in accordance with its intended purpose and under conditions of reasonably foreseeable misuse.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-032",
   "name": "Pre-market testing against defined metrics",
   "description": "The provider of a high-risk AI system shall test the system, prior to placing it on the market or putting it into service, against previously defined metrics and probabilistic thresholds appropriate to its intended purpose.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-033",
   "name": "Data governance for training, validation and testing data",
   "description": "The provider of a high-risk AI system that uses training of AI models shall subject training, validation and testing data sets to data governance and management practices covering design choices, data origin, preparation operations and bias examination.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-034",
   "name": "Logging capability supports traceability and monitoring",
   "description": "The provider of a high-risk AI system shall provide logging capabilities that record events relevant for identifying risk situations or substantial modifications, for post-market monitoring and for deployer monitoring of operation.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-035",
   "name": "Deployer retains logs of high-risk AI system for six months",
   "description": "The deployer of a high-risk AI system shall keep the logs automatically generated by that system, to the extent under its control, for a period appropriate to the intended purpose of at least six months.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-036",
   "name": "Instructions for use in a digital format",
   "description": "The provider of a high-risk AI system shall accompany the system with instructions for use in an appropriate digital format containing at least provider identity, performance characteristics and limitations, accuracy metrics, human oversight measures and log-handling mechanisms.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-037",
   "name": "High-risk AI system designed for effective human oversight",
   "description": "The provider of a high-risk AI system shall design and develop the system, including appropriate human-machine interface tools, so that natural persons can effectively oversee it while it is in use.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-038",
   "name": "Human can disregard, override or reverse AI output",
   "description": "The provider of a high-risk AI system shall enable the natural persons assigned to human oversight to decide not to use the system or to disregard, override or reverse its output.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-039",
   "name": "Measures against data poisoning and adversarial inputs",
   "description": "The provider of a high-risk AI system shall include, where appropriate, technical solutions to prevent, detect, respond to, resolve and control attacks on training data, pre-trained components, adversarial inputs and confidentiality attacks.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-040",
   "name": "Serious incident reporting for high-risk AI systems",
   "description": "The provider of a high-risk AI system placed on the Union market shall report any serious incident to the market surveillance authorities of the Member State where it occurred, not later than 15 days after becoming aware, with shorter periods for widespread infringements and deaths.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-041",
   "name": "Post-market monitoring system for high-risk AI",
   "description": "The provider of a high-risk AI system shall establish and document a post-market monitoring system, proportionate to the technology and risks, that actively and systematically collects and analyses performance data throughout the system's lifetime.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-042",
   "name": "Deployer uses high-risk AI per instructions for use",
   "description": "The deployer of a high-risk AI system shall take appropriate technical and organisational measures to use the system in accordance with its instructions for use.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-043",
   "name": "Deployer assigns competent persons to human oversight",
   "description": "The deployer of a high-risk AI system shall assign human oversight to natural persons who have the necessary competence, training and authority, as well as the necessary support.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-044",
   "name": "Deployer suspends use and informs on risk or serious incident",
   "description": "When a deployer has reason to consider that use of a high-risk AI system in accordance with its instructions may present a risk, the deployer shall without undue delay inform the provider or distributor and the market surveillance authority and shall suspend use of the system.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-045",
   "name": "Deployer informs persons subject to high-risk AI decisions",
   "description": "The deployer of an Annex III high-risk AI system that makes or assists in making decisions related to natural persons shall inform those natural persons that they are subject to the use of the system.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-046",
   "name": "Fundamental rights impact assessment before deployment",
   "description": "Before deploying a high-risk AI system referred to in Article 6(2), a deployer that is a body governed by public law or a private entity providing public services shall perform an assessment of the impact on fundamental rights, and shall notify its results to the market surveillance authority.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-047",
   "name": "Machine-readable marking of AI-generated output",
   "description": "The provider of an AI system generating synthetic audio, image, video or text content shall ensure that the outputs are marked in a machine-readable format and detectable as artificially generated or manipulated, using technical solutions that are effective, interoperable, robust and reliable as far as technically feasible.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-048",
   "name": "AI interaction notice clear, timely and accessible",
   "description": "The provider or deployer that must inform natural persons under Article 50(1) to (4) shall provide the information in a clear and distinguishable manner at the latest at the time of the first interaction or exposure, conforming to applicable accessibility requirements.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-049",
   "name": "Safeguards for Article 22 exceptions and special-category data",
   "description": "Where a controller relies on contract necessity or explicit consent for a decision based solely on automated processing with legal or similarly significant effects, the controller shall implement suitable safeguards including the rights to obtain human intervention, to express a point of view and to contest the decision, and shall not base the decision on special categories of data unless Article 22(4) conditions are met.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-050",
   "name": "Inform data subject of automated decision-making and its logic",
   "description": "Where personal data are processed in automated decision-making including profiling under Article 22(1) and (4), the controller shall provide the data subject with meaningful information about the logic involved and the significance and envisaged consequences of the processing.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-051",
   "name": "Access right covers existence and logic of automated decisions",
   "description": "Upon a data subject's access request, the controller shall confirm whether automated decision-making including profiling under Article 22(1) and (4) takes place and shall provide meaningful information about the logic involved and its consequences.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-052",
   "name": "Interoperability assessment before binding digital requirements",
   "description": "Before taking a decision on new or substantially modified binding requirements, a public sector body or Union entity shall carry out an interoperability assessment.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/903/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-053",
   "name": "Publish assessment report in a machine-readable format",
   "description": "The public sector body or Union entity that carried out an interoperability assessment shall publish a report of the outcome, in a machine-readable format facilitating automated translation, on an official website and share it electronically with the Interoperable Europe Board.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/903/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-054",
   "name": "Share interoperability solutions on request",
   "description": "A public sector body or Union entity shall make an interoperability solution supporting a trans-European digital public service, including technical documentation and references to open standards used, available to any other such body that requests it, subject to the stated exceptions.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/903/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-055",
   "name": "DPP data based on open standards, machine-readable and transferable",
   "description": "The economic operator creating a digital product passport shall ensure that all data in the passport is based on open standards, developed with an interoperable format and, as appropriate, machine-readable, structured, searchable and transferable through an open interoperable data exchange network without vendor lock-in.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-056",
   "name": "DPP linked to persistent unique product identifier via data carrier",
   "description": "The economic operator creating a digital product passport shall connect it through a data carrier to a persistent unique product identifier that complies with the standards referred to in Annex III.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-057",
   "name": "DPP fully interoperable with other passports",
   "description": "The digital product passport shall be fully interoperable with other digital product passports required under delegated acts in relation to technical, semantic and organisational aspects of end-to-end communication and data transfer.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-058",
   "name": "DPP data authenticity, reliability and integrity ensured",
   "description": "The digital product passport shall be designed and operated so that data authentication, reliability and integrity are ensured and a high level of security and privacy is provided and fraud is avoided.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-059",
   "name": "DPP write access restricted by access rights",
   "description": "The digital product passport shall restrict the rights to introduce, modify or update data in the passport based on the access rights specified in the applicable delegated act.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-060",
   "name": "DPP service providers do not reuse stored passport data",
   "description": "A digital product passport service provider that stores or processes passport data shall not sell, reuse or process the data beyond what is necessary for the storing or processing service, unless specifically agreed with the economic operator.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-061/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-061",
   "name": "Product data accessible with metadata in machine-readable format",
   "description": "Connected products shall be designed and manufactured, and related services designed and provided, so that product data and related service data, including the metadata necessary to interpret and use them, are by default easily, securely, free of charge accessible in a comprehensive, structured, commonly used and machine-readable format.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-062/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-062",
   "name": "Data-space participants describe formats, vocabularies and code lists",
   "description": "A participant in a data space that offers data or data services to other participants shall describe data structures, data formats, vocabularies, classification schemes, taxonomies and code lists, where available, in a publicly available and consistent manner.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-063/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-063",
   "name": "Interoperability of tools automating data sharing agreements",
   "description": "Where applicable, a participant in a data space that offers data or data services to other participants shall provide the means to enable interoperability of tools for automating the execution of data sharing agreements, such as smart contracts.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-064/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-064",
   "name": "Oversight measures commensurate with the level of autonomy",
   "description": "The provider of a high-risk AI system shall identify human oversight measures that are commensurate with the risks, level of autonomy and context of use of the system, and shall either build them into the system where technically feasible or specify them for the deployer to implement.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-065/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-065",
   "name": "Overseers can understand capacities and limits and monitor operation",
   "description": "The provider of a high-risk AI system shall provide it to the deployer in such a way that the natural persons assigned to human oversight are enabled, as appropriate and proportionate, to understand its relevant capacities and limitations and to monitor its operation, including to detect and address anomalies, dysfunctions and unexpected performance.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-066/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-066",
   "name": "Overseers can remain aware of automation bias",
   "description": "The provider of a high-risk AI system shall provide it to the deployer in such a way that the natural persons assigned to human oversight are enabled, as appropriate and proportionate, to remain aware of the possible tendency of automatically relying or over-relying on the output of the system.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-067/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-067",
   "name": "Employer informs workers before using a high-risk AI system at the workplace",
   "description": "Before putting a high-risk AI system into service or using it at the workplace, a deployer who is an employer shall inform the workers' representatives and the affected workers that they will be subject to its use.",
   "ebw:category": "AIF",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-aif-068/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-AIF-068",
   "name": "Owner can decommission an agent",
   "description": "The wallet shall enable the owner to decommission an AI agent, which revokes all mandates and credentials issued to that agent.",
   "ebw:category": "AIF",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-001",
   "name": "Public sector acceptance within 24 months",
   "description": "By 24 months after entry into force, public sector bodies shall enable economic operators to identify and authenticate, sign or seal, submit documents and send or receive notifications using the core functionalities of European Business Wallets for reporting obligations or administrative procedures.",
   "ebw:category": "BIZ",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-002",
   "name": "Pre-contract disclosure of terms and limitations",
   "description": "Before entering a contract, the qualified trust service provider shall inform any person seeking to use the service of the precise terms and conditions, including limitations on use, in a clear and easily accessible manner.",
   "ebw:category": "BIZ",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-003",
   "name": "No obligation on economic operators to adopt a business wallet",
   "description": "The business wallet framework shall not impose an obligation on economic operators to obtain or use a European Business Wallet; adoption shall remain their choice.",
   "ebw:category": "BIZ",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-004",
   "name": "Sole traders reach wallet trust services through the EUDI Wallet",
   "description": "Self-employed individuals and sole traders shall be able to use their European Digital Identity Wallets to access the trust services offered for European Business Wallets, including the secure communication channel and electronic signatures, without acquiring a full European Business Wallet.",
   "ebw:category": "BIZ",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-005",
   "name": "Microenterprise onboarding by web or mobile application",
   "description": "The onboarding of a microenterprise to a business wallet shall be achievable with a web-based or mobile application requiring only minimal installation and configuration and no individual contracting procedure.",
   "ebw:category": "BIZ",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/transparency/documents-register/api/files/SWD(2025)837_0/090166e5258f2ae9?rendition=false"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-006",
   "name": "Cost model with size-specific one-off and recurring costs",
   "description": "The cost-benefit assessment of the business wallet shall distinguish microenterprises, SMEs of 10 to 250 employees and corporates, with one-off costs for training and onboarding, activation and IT implementation and contracting, and recurring licensing and maintenance fees.",
   "ebw:category": "BIZ",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/transparency/documents-register/api/files/SWD(2025)837_0/090166e5258f2ae9?rendition=false"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-007",
   "name": "Review assesses the impact on micro-enterprises and SMEs",
   "description": "The Commission report reviewing the application of the Regulation shall include a specific assessment of the impact of the Regulation on micro-enterprises and small and medium-sized enterprises, and shall assess whether an obligation to use European Business Wallets is necessary.",
   "ebw:category": "BIZ",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-biz-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-BIZ-008",
   "name": "Compensation for data access capped at cost for SME recipients",
   "description": "Where the data recipient is an SME or a not-for-profit research organisation without non-SME partner or linked enterprises, any compensation agreed for making data available shall not exceed the costs of making the data available.",
   "ebw:category": "BIZ",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-001",
   "name": "Audit of qualified providers",
   "description": "A qualified trust service provider shall be audited by a conformity assessment body at least every 24 months, and the audit report shall be submitted to the supervisory body within three working days.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-002",
   "name": "Submission of conformity assessment report",
   "description": "The qualified trust service provider shall submit the conformity assessment report to the supervisory body within three working days of receipt.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-003",
   "name": "Advance notice of planned audits",
   "description": "The qualified trust service provider shall inform the supervisory body at least one month before any planned audit and allow the supervisory body to observe on request.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-004",
   "name": "Supervisory ad hoc audits at provider expense",
   "description": "The qualified trust service provider shall accept audits or conformity assessments requested by the supervisory body at any time at the provider's expense.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-005",
   "name": "Creation device certification validity",
   "description": "The validity of a certification of a qualified electronic signature creation device shall not exceed five years, provided vulnerability assessments are carried out every two years, and the certification shall be cancelled where identified vulnerabilities are not remedied.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-006",
   "name": "Seal devices follow signature device rules",
   "description": "The qualified electronic seal creation device, its certification and its remote management service shall meet the requirements applicable to signature creation devices.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-007",
   "name": "Certificate holder reports breaches to certification body",
   "description": "The holder of a certificate of conformity for a wallet solution shall notify its certification body without undue delay of any breach or compromise likely to affect conformity.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-008",
   "name": "Certification body suspends and cancels on unremedied compromise",
   "description": "The certification body shall suspend a certificate of conformity without undue delay once it confirms that a notified breach affects conformity, and shall cancel it if the breach is not remedied in a timely manner.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-009",
   "name": "Critical-asset operations meet LoA substantial design rules",
   "description": "Where critical assets relate to performing electronic identification at assurance level substantial, the European Business Wallet shall perform cryptographic operations processing critical assets in accordance with the characteristics and design requirements for electronic identification means at assurance level substantial in Implementing Regulation (EU) 2015/1502.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-010",
   "name": "Secure cryptographic components meet LoA substantial design",
   "description": "The wallet secure cryptographic applications and devices shall comply with the requirements for the characteristics and design of electronic identification means at assurance level substantial in Implementing Regulation (EU) 2015/1502.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-011",
   "name": "Verify issuance, delivery and activation at LoA substantial",
   "description": "The wallet solution shall support mechanisms that enable providers of owner identification data to verify issuance, delivery and activation in compliance with assurance level substantial requirements in Implementing Regulation (EU) 2015/1502.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-012",
   "name": "Activate a unit only with a certified secure device",
   "description": "The wallet provider shall activate a new wallet unit only after verifying that the unit includes a wallet secure cryptographic application and device certified as compliant with the requirements for assurance level high.",
   "ebw:category": "CER",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-013",
   "name": "Secure device assessed at assurance level high",
   "description": "National certification schemes for wallet solutions shall require that the wallet secure cryptographic device is assessed against the requirements of assurance level high as a prerequisite to certification.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-014",
   "name": "Vulnerability assessment of the secure device at AVA_VAN.5",
   "description": "National certification schemes shall require the evaluation of a wallet secure cryptographic device that is within the object of certification to include a vulnerability assessment at level AVA_VAN.5 of EN ISO/IEC 15408-3, unless a lower level is duly justified to the certification body.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-015",
   "name": "Device assumptions stay verified after certification",
   "description": "National certification schemes shall require evaluation activities that confirm, after issuance of the certificate, that the assumptions made on the wallet secure cryptographic device are still verified, and shall require applicants to describe the measures that keep them verified throughout the certification lifecycle.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-016",
   "name": "Unsuitable secure device blocks the certificate",
   "description": "National certification schemes shall deem a wallet secure cryptographic device unsuitable, so that the wallet solution is not issued a certificate of conformity, where verifications of the device remain inconclusive and compensating requirements for the wallet secure cryptographic application are not possible.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-017",
   "name": "Evaluation of architectures with several secure devices",
   "description": "National certification schemes shall include evaluation activities that ensure the overall solution offers the expected level of security where an architecture uses several wallet secure cryptographic devices or performs some operations on critical assets outside the device.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-018",
   "name": "Enforce unproven assumptions on the operating environment",
   "description": "National certification schemes shall require, for each assumption on the operating environment of the wallet solution that is not backed by a certificate of conformity or other acceptable assurance information, a description of the mechanism the wallet provider uses to enforce the assumption and a justification that the mechanism is sufficient.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-019",
   "name": "Sole control assurance level 2 for remote qualified signing in wallets",
   "description": "Wallet providers and qualified trust service providers providing the remote qualified signature or seal creation part of a wallet solution shall comply with sole control assurance level 2 as defined in EN 419 241-1.",
   "ebw:category": "CER",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-020",
   "name": "CSP-B verifies certificates of conformity",
   "description": "The core service provider-B shall, where applicable, verify the provided certificates of conformity for all requested roles.",
   "ebw:category": "CER",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-021",
   "name": "Certificate lists the sites and addresses it covers",
   "description": "The certificate provider shall identify in the certificate offer all sites and addresses, by BPNS and BPNA, for which the certificate is valid.",
   "ebw:category": "CER",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0135-CompanyCertificateManagement"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-022",
   "name": "Remote device provider follows the device certification report",
   "description": "A qualified trust service provider managing remote qualified signature creation devices shall comply with any requirements identified in the certification report of the specific remote device.",
   "ebw:category": "CER",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-cer-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CER-023",
   "name": "Evidence for an owner-operated module before activation",
   "description": "Where a hardware security module operated by the owner is to act as the secure cryptographic device of a wallet unit, the wallet provider shall obtain and record evidence of its evaluation, at the level that applies to the provider's own devices, before it activates the unit.",
   "ebw:category": "CER",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-001",
   "name": "Public sector infrastructures migrate to post-quantum cryptography",
   "description": "The public sector bodies that exchange data with business wallets shall consider migrating the digital infrastructures and services they operate to post-quantum cryptography as soon as possible.",
   "ebw:category": "CON",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reco/2024/1101/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-002",
   "name": "vLEI credentials are ACDC based",
   "description": "All instantiated vLEI credentials shall be ACDC compliant.",
   "ebw:category": "CON",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.gleif.org/organizational-identity/become-a-vlei-issuer-qvi/vlei-ecosystem-governance-framework/2026-03-25_vlei-egf-v4.0-technical-requirements-part-2-vlei-credentials_v1.2_final.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-003",
   "name": "vLEI issuer and holder identifiers are KERI AIDs",
   "description": "Issuer and holder identifiers of vLEI credentials shall be KERI AIDs.",
   "ebw:category": "CON",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.gleif.org/organizational-identity/become-a-vlei-issuer-qvi/vlei-ecosystem-governance-framework/2026-03-25_vlei-egf-v4.0-technical-requirements-part-2-vlei-credentials_v1.2_final.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-004",
   "name": "DPP requirements differ per product group and legal act",
   "description": "The business wallet design shall not assume a single DPP data model or access scheme, because DPP requirements are set per product group either by delegated acts under Regulation (EU) 2024/1781 or by separate Union legislation.",
   "ebw:category": "CON",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://single-market-economy.ec.europa.eu/single-market/digital-product-passport_en"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-005",
   "name": "Wallet authorisations do not create or limit a legal mandate",
   "description": "Authorisations granted through the authorisation system of a European Business Wallet shall be treated as technical and shall not create, limit or otherwise affect any power of attorney or legal mandate under national or Union law.",
   "ebw:category": "CON",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-006",
   "name": "Existing electronic format requirements remain applicable",
   "description": "Where existing Union or national law includes requirements relating to electronic formats as part of an administrative procedure, those requirements shall remain applicable and shall be observed when the core functionalities of a European Business Wallet are used.",
   "ebw:category": "CON",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-007",
   "name": "Council text ties legal equivalence to qualified trust services",
   "description": "Where a European Business Wallet owner or authorised user makes use of a qualified trust service forming part of the core functionalities, the resulting action shall have the same legal effect as if carried out in person, in paper form or by other compliant means.",
   "ebw:category": "CON",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-008",
   "name": "Existing systems for exchange between authorities stay in place",
   "description": "The Regulation shall be without prejudice to the existing systems and procedures mandated by Union law governing the exchange of documents and data between competent authorities.",
   "ebw:category": "CON",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-con-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-CON-009",
   "name": "Cost model assumes all public sector bodies adopt the wallet",
   "description": "The sizing and cost assumptions for the business wallet ecosystem shall treat all public sector bodies as adopters, independent of the level of adoption by economic operators.",
   "ebw:category": "CON",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/transparency/documents-register/api/files/SWD(2025)837_0/090166e5258f2ae9?rendition=false"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-001",
   "name": "Machine-readable description of datasets and usage terms",
   "description": "A participant in a data space that offers data or data services shall describe dataset content, use restrictions, licences, collection methodology, quality and uncertainty in a machine-readable format where applicable.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-002",
   "name": "Describe access means, terms of use and quality of service",
   "description": "A participant in a data space that offers data or data services shall describe the technical means of access, such as APIs, with their terms of use and quality of service sufficiently to enable automatic access and transmission.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-003",
   "name": "BPN credential issued by the core service provider",
   "description": "The Catena-X core service provider shall issue the Business Partner Number credential that attests the BPN associated with the credential subject.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0050-CXSpecificCredentials/CX-0050-CatenaXSpecificVerifiableCredentials"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-004",
   "name": "Business Partner Number is stable and never reassigned",
   "description": "A Business Partner Number shall never change structurally, shall never cease to exist and shall never be reassigned.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-005",
   "name": "Machine-readable and searchable storage of submitted data",
   "description": "Member States shall ensure that all documents and information submitted as part of formation, branch registration or a filing are stored by the registers in a machine-readable and searchable format or as structured data.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-006",
   "name": "Legal-person representatives shown with EUID or registration number",
   "description": "Where persons authorised to represent a company are legal persons, Member States shall ensure that the name of the company, its legal form and its EUID, or its registration number where the EUID is not applicable, are made publicly available through the system of interconnection of registers.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-007",
   "name": "Free access to core company data including representatives",
   "description": "Member States shall ensure that the name, legal form, registered office, registration number and EUID, status, and particulars of the persons currently authorised to represent the company, including whether they may act alone or jointly, are available free of charge through the system of interconnection of registers.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-008",
   "name": "EU Company Certificate content on identity and representation",
   "description": "The EU Company Certificate for limited liability companies shall include the name, legal form, registration number and Member State, EUID, registered office, correspondence address, status, and the persons authorised to represent the company and whether they act alone or jointly.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-009",
   "name": "Verify third-party status with no more information than necessary",
   "description": "For the purpose of verifying whether a natural or legal person qualifies as a user or as a third party, the user or third party shall not be required to provide any information beyond what is necessary, and the data holder shall not keep information on the third party’s access beyond what is necessary.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-010",
   "name": "Data shared on request of the user or a party acting for the user",
   "description": "Upon request by a user, or by a party acting on behalf of a user, the data holder shall make readily available data and the relevant metadata available to a third party without undue delay, in a comprehensive, structured, commonly used and machine-readable format.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-011",
   "name": "Smart contracts for data sharing offer robustness and access control",
   "description": "The vendor of an application using smart contracts to execute a data sharing agreement shall ensure that the smart contracts are designed with access control mechanisms and a very high degree of robustness to avoid functional errors and withstand manipulation by third parties.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-012",
   "name": "Smart contracts can be safely terminated or interrupted",
   "description": "The vendor of an application using smart contracts to execute a data sharing agreement shall ensure that a mechanism exists to terminate the continued execution of transactions and that the smart contract includes internal functions that can reset or instruct it to stop or interrupt operation.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-013",
   "name": "Export of exportable data in machine-readable form on switching",
   "description": "In switching between services of the same service type without published common specifications, the provider of data processing services shall, at the request of the customer, export all exportable data in a structured, commonly used and machine-readable format.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-014",
   "name": "Publish the jurisdiction governing the ICT infrastructure",
   "description": "Providers of data processing services shall make available on their websites, and keep up to date, the jurisdiction to which the ICT infrastructure for each service is subject and a description of measures taken to prevent unlawful international governmental access to or transfer of non-personal data.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-015",
   "name": "Data intermediation providers notify before starting",
   "description": "Any data intermediation services provider that intends to provide data intermediation services shall submit a notification to the competent authority for data intermediation services.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-016",
   "name": "Non-Union intermediaries designate a legal representative in the Union",
   "description": "A data intermediation services provider that is not established in the Union but offers services within it shall designate a legal representative in one of the Member States in which those services are offered, mandated to be addressed by the competent authorities.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-017",
   "name": "Notification identifies the provider as a legal entity",
   "description": "The notification of a data intermediation services provider shall include its name, its legal status, form, ownership structure and relevant subsidiaries, and its trade register number where registered.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-018",
   "name": "Commission keeps a public register of data intermediation providers",
   "description": "The Commission shall keep and regularly update a public register of all data intermediation services providers providing their services in the Union, and the notified name, legal status, address, website, service description and start date shall be published in it.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-019",
   "name": "Data intermediaries ensure interoperability with each other",
   "description": "The data intermediation services provider shall take appropriate measures to ensure interoperability with other data intermediation services, inter alia by means of commonly used open standards in its sector.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-020",
   "name": "Tools to give and withdraw consent and permissions",
   "description": "A data intermediation services provider that provides tools for obtaining consent from data subjects or permissions from data holders shall provide data subjects with tools to give and withdraw consent and data holders with tools to give and withdraw permissions to process data.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-021",
   "name": "Altruism organisations provide consent and withdrawal tools",
   "description": "A recognised data altruism organisation shall provide tools for obtaining consent from data subjects or permissions from data holders, and tools for easy withdrawal of such consent or permission.",
   "ebw:category": "DAT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/868/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-022",
   "name": "Credentials and presentations use one profile",
   "description": "In a data space that uses the Decentralized Claims Protocol, a credential and the presentation that carries it shall use the same data model version and the same proof mechanism.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eclipse-dataspace-dcp.github.io/decentralized-claims-protocol/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-023",
   "name": "Data space participant identifier is a DID",
   "description": "A participant in a data space that uses the Decentralized Claims Protocol shall use a decentralized identifier as its participant identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eclipse-dataspace-dcp.github.io/decentralized-claims-protocol/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-024",
   "name": "BPN issued only with a Golden Record",
   "description": "The BPN issuing organisation shall issue a Business Partner Number only if a corresponding Golden Record exists.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-025",
   "name": "BPNL Golden Record holds legal name, form and address",
   "description": "The Golden Record of a legal entity shall contain the legal name, the legal form and the legal address of the organisation before a BPNL is issued.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-026",
   "name": "BPNL requires a legally secure external identifier",
   "description": "The Golden Record of a legal entity shall contain at least one external identifier of a legally secure identifier type.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-027",
   "name": "VAT identifier first for BPNL",
   "description": "Where the country of the legal address has a VAT identifier type and the organisation is subject to value-added tax, the Golden Record of the legal entity shall contain a VAT identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-028",
   "name": "TIN identifier as second choice for BPNL",
   "description": "Where the VAT rule does not apply, the country of the legal address has a publicly available TIN identifier type and the organisation is subject to tax there, the Golden Record shall contain a TIN identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-029",
   "name": "National business register identifier as third choice for BPNL",
   "description": "Where neither the VAT rule nor the TIN rule applies and the organisation is registered in a national business register of the country of its legal address, the Golden Record shall contain that national business registration identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-030",
   "name": "International register identifier as last choice for BPNL",
   "description": "Where none of the VAT, TIN and national business registration rules applies and the organisation has an international business registration identifier, the Golden Record shall contain that identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-031",
   "name": "No BPNL without a legally secure identifier",
   "description": "The BPN issuing organisation shall not issue a BPNL where the Golden Record contains none of a VAT, TIN, national business registration or international business registration identifier.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-032",
   "name": "BPNL issued for capital companies",
   "description": "The BPN issuing organisation shall issue a BPNL for capital companies.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-033",
   "name": "Inactive business partner stays accessible",
   "description": "The business partner data management shall keep a business partner and its BPN accessible after the business partner becomes inactive.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-034",
   "name": "TIN not used where not publicly available",
   "description": "The TIN identifier shall not be used to identify organisations in countries where legal regulations do not allow it.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-035",
   "name": "Legal name and address in Latin letters",
   "description": "The legal name and address data of a business partner record shall be provided using Latin letters.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-036",
   "name": "De-duplication in the Golden Record process",
   "description": "The service provider shall perform a de-duplication as part of the Golden Record process.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-037",
   "name": "Legal form coded by ISO 20275 ELF",
   "description": "The Golden Record of a legal entity shall hold a legal form whose technical key corresponds to the ISO 20275 entity legal form code.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-038",
   "name": "Legal entity type set after register match",
   "description": "The service provider shall set the type of a record to legal entity (BPNL) if the combination of identifier, legal name and address is found in the commercial register or an equivalent official register.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-039",
   "name": "Tax number checked against national registers",
   "description": "The service provider shall check that the tax number is correct according to national registers and their syntax.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-040",
   "name": "Format check of other identifiers such as LEI",
   "description": "The service provider shall check that the format of an other identifier, such as DUNS, LEI, EIN, UBI or GLN, is valid.",
   "ebw:category": "DAT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dat-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DAT-041",
   "name": "Identifier of a sole trader disclosed only as requested",
   "description": "Where the owner is a natural person such as a self-employed person or sole trader, the wallet shall limit the unique identifier and other owner identification attributes it presents to a relying party to what that relying party needs for its purpose.",
   "ebw:category": "DAT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-001",
   "name": "Operator and facility identifiers follow ISO/IEC 15459",
   "description": "The unique operator identifiers and unique facility identifiers used in a digital product passport shall comply with the standards referred to in Annex III of Regulation (EU) 2024/1781, or with equivalent European or international standards until harmonised standards are published.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-002",
   "name": "Request a missing unique operator identifier on behalf of the actor",
   "description": "Where a unique operator identifier is not yet available for an actor, the economic operator that creates or updates the digital product passport shall request one on behalf of that actor and shall give that actor the full details once issued.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-003",
   "name": "Economic operator uploads identifiers to the registry",
   "description": "The economic operator placing the product on the market or putting it into service shall upload to the digital product passport registry the data referred to in Article 13(1) and (2) of Regulation (EU) 2024/1781.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-004",
   "name": "Authorities and customs access to the DPP registry",
   "description": "The Commission, competent national authorities and customs authorities shall have access to the digital product passport registry for the purposes of carrying out their duties pursuant to Union law.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-005",
   "name": "Free and easy DPP access for actors per their access rights",
   "description": "The digital product passport shall give customers, manufacturers, importers, distributors, dealers, professional repairers, independent operators, refurbishers, remanufacturers, recyclers, market surveillance authorities, customs authorities and other relevant actors free of charge and easy access, based on their respective access rights in the applicable delegated act.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-006",
   "name": "Wallet support for DPP economic operator credentials",
   "description": "Where implementing acts under Article 11 of Regulation (EU) 2024/1781 set procedures to issue and verify the digital credentials of economic operators with DPP access rights, the business wallet shall support holding and presenting those credentials.",
   "ebw:category": "DOM",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1781/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-007",
   "name": "Battery passport for LMT, industrial and EV batteries",
   "description": "From 18 February 2027 each LMT battery, each industrial battery with a capacity greater than 2 kWh and each electric vehicle battery placed on the market or put into service shall have an electronic record (battery passport).",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-008",
   "name": "Three access tiers in the battery passport",
   "description": "The battery passport shall contain information accessible to the general public, information accessible only to notified bodies, market surveillance authorities and the Commission, and information accessible only to natural or legal persons with a legitimate interest.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-009",
   "name": "Written authorisation for an operator acting for the passport",
   "description": "Where the economic operator placing the battery on the market authorises another operator to act on its behalf for the battery passport, that authorisation shall be given in writing.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-010",
   "name": "Only verified identity, role and legitimacy may use the repository",
   "description": "A legal entity establishing and managing a repository of the medicines verification system shall put in place security procedures ensuring that only users whose identity, role and legitimacy has been verified can access the repository or upload data.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2016/161/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-011",
   "name": "National competent authorities get access to the repository",
   "description": "A legal entity managing a repository used to verify or decommission unique identifiers shall grant access to the repository and its information to the competent authorities of the Member State for supervision, investigation of falsification, reimbursement, and pharmacovigilance or pharmacoepidemiology.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2016/161/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-012",
   "name": "Union database of GMP/GDP certificates and registrations is public",
   "description": "The Union database holding certificates of good manufacturing practice and good distribution practice and the registration of importers, manufacturers and distributors of active substances shall be publicly accessible.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2011/62/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-013",
   "name": "Due diligence statement submitted before placing on the market",
   "description": "Operators shall not place relevant products on the market or export them without prior submission of a due diligence statement made available to the competent authorities through the information system.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1115/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-014",
   "name": "Registration of operators and authorised representatives, EORI",
   "description": "The Commission information system for due diligence statements shall provide registration of operators and traders and their authorised representatives, and shall include the EORI number in the registration profile of operators placing products under release for free circulation or export.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1115/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-015",
   "name": "Authorised representative provides a copy of the mandate on request",
   "description": "The authorised representative submitting a due diligence statement shall, upon request, provide a copy of the mandate in an official language of the Union to the competent authorities, while the operator or trader retains responsibility for compliance.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2023/1115/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-016",
   "name": "Economic operators register with the responsible customs authority",
   "description": "Economic operators established in the customs territory of the Union shall register with the customs authorities responsible for the place where they are established.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32013R0952"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-017",
   "name": "Evidence of empowerment on request of customs",
   "description": "Where the customs authorities require it, a person stating that he or she is acting as a customs representative shall provide evidence of empowerment by the person represented.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32013R0952"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-018",
   "name": "eFTI data made available over an authenticated and secure connection",
   "description": "Economic operators concerned shall make regulatory information in machine-readable format available to the competent authority via an authenticated and secure connection to the data source of an eFTI platform.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2020/1056/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-019",
   "name": "eFTI operation logs identify the natural or legal person acting",
   "description": "An eFTI platform shall record all data processing in operation logs that allow, as a minimum, identification of each distinct processing operation, the natural or legal person who made it and the sequence of operations on each data element.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2020/1056/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-020",
   "name": "Non-discriminatory access of eligible parties to customer data",
   "description": "The parties responsible for data management shall provide access to the data of the final customer to any eligible party, which shall have the requested data at its disposal in a non-discriminatory manner and simultaneously.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/944/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-021",
   "name": "Grant and revoke data access permissions on customer request",
   "description": "The permission administrator shall grant permission to access validated historical metering and consumption data to eligible parties, and revoke permissions, without unnecessary delay on the final customer’s request.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2023/1162/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-022",
   "name": "Active permission verified before data is transferred",
   "description": "When transferring data to eligible parties, the metered data administrator shall ensure, in cooperation with the permission administrator where applicable, that there is an active permission or another legal basis for the data to be lawfully transmitted or processed.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2023/1162/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-023",
   "name": "Market roles identified by organisation code and type",
   "description": "In the reporting of national practices, each metered data administrator, metering point administrator, data access provider and permission administrator shall be described by name and by an organisation code with its type of identification, namely ACER registration code, LEI, BIC, EIC, GLN or national identification code.",
   "ebw:category": "DOM",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2023/1162/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-024",
   "name": "Mandatory BPN issuance for European countries only",
   "description": "The BPN issuing organisation shall issue BPNs for organisations and organisation parts in all EU member states, Great Britain, Switzerland, Norway and Northern Ireland.",
   "ebw:category": "DOM",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-025",
   "name": "Tax number required per country unless law says otherwise",
   "description": "The Golden Record shall contain a tax number for legal entities in the countries listed in the country rules, unless local law or tax regulations do not require a tax number.",
   "ebw:category": "DOM",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-dom-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-DOM-026",
   "name": "Tax jurisdiction code for BR, CA and US",
   "description": "The service provider shall require a tax jurisdiction code for legal entities in Brazil, Canada and the United States (including Puerto Rico).",
   "ebw:category": "DOM",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-001",
   "name": "Qualified registered delivery in the wallet",
   "description": "A European Business Wallet shall allow its owner to transmit and receive electronic documents and data by means of a qualified electronic registered delivery service.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-002",
   "name": "Updates to the European Digital Directory",
   "description": "A European Business Wallet provider shall send updates of owner information to the European Digital Directory within one working day.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-003",
   "name": "Attestation lifecycle in the wallet",
   "description": "The European Business Wallet shall enable the owner to securely issue, request, obtain, select, combine, store, delete, share and present electronic attestations of attributes.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-004",
   "name": "Selective disclosure of identification data and attributes",
   "description": "The European Business Wallet shall enable the owner to selectively disclose European Business Wallet owner identification data and attributes contained in electronic attestations of attributes.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-005",
   "name": "Qualified signing and sealing",
   "description": "The European Business Wallet shall enable the owner to sign by means of qualified electronic signatures and to seal by means of qualified electronic seals, as applicable.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-006",
   "name": "Qualified time stamping",
   "description": "The European Business Wallet shall enable the owner to bind data in electronic form to a particular time by means of qualified electronic time stamps.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-007",
   "name": "Issuing attestations to business and personal wallets",
   "description": "The European Business Wallet shall enable the owner to issue electronic attestations of attributes to European Business Wallets and European Digital Identity Wallets.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-008",
   "name": "Linked chain of issued attestations",
   "description": "The European Business Wallet shall allow an attestation issued through the owner's wallet to be linked to other relevant attestations forming part of a chain.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-009",
   "name": "Authentication using attestations",
   "description": "The European Business Wallet shall enable the use of qualified and non-qualified electronic attestations of attributes for owners and their authorised representatives to authenticate themselves.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-010",
   "name": "Multi-user access with manageable authorisations",
   "description": "The European Business Wallet shall enable the owner to authorise multiple users to access and operate the wallet and to manage and revoke such authorisations.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-011",
   "name": "Authorising relying parties to request attestations",
   "description": "The European Business Wallet shall enable the owner to authorise relying parties to request electronic attestations of attributes issued to the owner and to manage and revoke such authorisations.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-012",
   "name": "Common dashboard for registered delivery communications",
   "description": "The European Business Wallet shall provide a common dashboard for accessing, storing and verifying communications exchanged through the qualified electronic registered delivery service.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-013",
   "name": "Registered delivery as standalone service for personal wallet users",
   "description": "The provider of European Business Wallets shall enable the provision of the qualified electronic registered delivery service as a standalone service to users of European Digital Identity Wallets.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-014",
   "name": "Automated and manual wallet interaction",
   "description": "The European Business Wallet shall support common protocols and interfaces that allow interaction with the wallet automatically without manual intervention or through direct user action.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-015",
   "name": "Real-time detection of role conflicts and over-delegation",
   "description": "The provider of European Business Wallets shall ensure that conflicts of roles, over-delegation or expired authorisations are automatically detected and prevented in real time.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-016",
   "name": "Directory information kept current and corroborated",
   "description": "The provider of European Business Wallets shall ensure that information on owners notified to the Commission is kept up to date and corroborated using the issuing provider of owner identification data.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-017",
   "name": "Public sector bodies hold wallets with registered delivery",
   "description": "For submitting documents and sending or receiving notifications, public sector bodies shall have European Business Wallets, including the qualified electronic registered delivery service.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-018",
   "name": "Certificate database for qualified certificates",
   "description": "The qualified trust service provider issuing qualified certificates shall establish and keep updated a certificate database.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-019",
   "name": "Advanced signature requirements",
   "description": "The advanced electronic signature shall be uniquely linked to the signatory, identify the signatory, be created under the signatory's sole control and make any subsequent data change detectable.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-020",
   "name": "Signature validation system result and issue detection",
   "description": "The system used for validating a qualified electronic signature shall provide the relying party the correct validation result and allow it to detect any security relevant issues.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-021",
   "name": "Qualified validation result sealed by provider",
   "description": "The qualified validation service shall let relying parties receive the validation result in an automated, reliable and efficient manner bearing the advanced signature or seal of the service provider.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-022",
   "name": "Advanced seal requirements",
   "description": "The advanced electronic seal shall be uniquely linked to the creator, identify the creator, be created with data the creator can control with high confidence and make subsequent data change detectable.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-023",
   "name": "Qualified time stamp requirements",
   "description": "The qualified electronic time stamp shall bind date and time to data so undetected change is precluded, use a time source linked to UTC, and be signed or sealed by the qualified provider.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-024",
   "name": "Sender and addressee identification in qualified delivery",
   "description": "The qualified electronic registered delivery service shall identify the sender with a high level of confidence and identify the addressee before delivery of the data.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-025",
   "name": "Delivery data secured and time-stamped",
   "description": "The qualified electronic registered delivery service shall secure sending and receiving with an advanced signature or seal of a qualified provider, indicate any data change, and time-stamp sending, receipt and changes with a qualified time stamp.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-026",
   "name": "Verification of attributes against authentic sources",
   "description": "The Member State shall ensure that, at least for Annex VI attributes relying on public sector authentic sources, qualified providers of attestations can verify them electronically at the user's request.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-027",
   "name": "Attestation lifecycle in wallets irrespective of Member State",
   "description": "The provider of electronic attestations of attributes shall let wallet users request, obtain, store and manage attestations irrespective of the Member State where the wallet is provided.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-028",
   "name": "Key generation, proof of possession and secure erasure",
   "description": "The wallet provider shall ensure that the wallet secure cryptographic application is able to generate new cryptographic keys, generate a proof of possession of private keys, and securely erase critical assets.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-029",
   "name": "Wallet user right to request wallet revocation",
   "description": "The wallet provider shall provide mechanisms, independent of wallet units, for secure identification and authentication of wallet users, and shall ensure that wallet users can request revocation of their wallet unit attestations using those mechanisms.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-030",
   "name": "Check relying party against embedded disclosure policy",
   "description": "The wallet instance shall verify whether the wallet-relying party complies with the embedded disclosure policy of an attestation and shall inform the wallet user of the result.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-031",
   "name": "Secure export and portability to another wallet",
   "description": "Where technically feasible and excepting critical assets, the wallet unit shall support secure export and portability of the wallet user personal data so that the user can migrate to a wallet unit of a different wallet solution at assurance level high.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-032",
   "name": "Selective disclosure and key possession proof",
   "description": "The wallet solution shall support selective disclosure of attributes of person identification data and attestations, and the wallet unit shall support proving possession of the private keys used in cryptographic bindings.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-033",
   "name": "Communicate data erasure requests to relying parties",
   "description": "The wallet unit shall support protocols and interfaces allowing the wallet user to request erasure of personal data from selected wallet-relying parties, and shall display previously submitted requests.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-034",
   "name": "Evaluate embedded disclosure policy against registration certificate",
   "description": "The wallet unit shall evaluate an embedded disclosure policy together with the registration certificate information from the relying party to determine whether the relying party is permitted by the attestation provider to access the attestation.",
   "ebw:category": "FUN",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-035",
   "name": "Access decisions consider mandate scope, validity and constraints",
   "description": "The provider of European Business Wallets shall ensure that authorisation decisions under the access control mechanism are based on the scope, validity and constraints of any mandate, delegation or power of attorney, as appropriate to the access request.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-036",
   "name": "Real-time validation of roles and mandates",
   "description": "The provider of European Business Wallets shall ensure that access to business processes, digital procedures or submission interfaces is controlled by real-time validation of roles and mandates.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-037",
   "name": "Access decisions based on the current actor only",
   "description": "When applying access control policy to a delegated token, the consumer shall consider only the top-level claims and the party identified as the current actor.",
   "ebw:category": "FUN",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc8693"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-038",
   "name": "Support for natural persons representing the owner",
   "description": "The European Business Wallet provider shall enable a natural person representing another natural person or a legal person to use the European Business Wallet as a user.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-039",
   "name": "PID may represent a person representing a legal person",
   "description": "The Member State shall ensure that the person identification data available from the electronic identification scheme uniquely represents the natural person, legal person or the natural person representing the natural or legal person, and is associated with the wallet.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-040",
   "name": "Free qualified signing for natural persons by default",
   "description": "The Member State shall ensure that the European Digital Identity Wallet offers all natural persons the ability to sign by means of qualified electronic signatures by default and free of charge.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-041",
   "name": "Users can receive qualified certificates for signatures and seals",
   "description": "The European Business Wallet provider shall ensure that users are able to receive qualified certificates for qualified electronic signatures or seals linked to local, external or remote qualified creation devices.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-042",
   "name": "Authorisation decisions based on defined criteria",
   "description": "The European Business Wallet provider shall base authorisation decisions under the access control mechanism on the attestations of the acting subject, formal role, the scope, validity and constraints of any mandate, delegation or power of attorney, or sector rules.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-043",
   "name": "Real-time validation of roles and mandates for submissions",
   "description": "The European Business Wallet provider shall control access to business processes, digital procedures and submission interfaces by real-time validation of roles and mandates.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-044",
   "name": "Request owner identification data for a third-country operator",
   "description": "The provider of European Business Wallets shall request owner identification data from a provider of owner identification data on behalf of an economic operator established in a third country.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-045",
   "name": "European Digital Identity Wallet usable in online company procedures",
   "description": "Member States shall ensure that a European Digital Identity Wallet can be used as an electronic identification means by applicants in the online procedures of Chapter III of Directive (EU) 2017/1132.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-046",
   "name": "Complete online filing of documents and changes",
   "description": "Member States shall ensure that documents and information, including any changes thereto, can be filed online with the register where the company is registered.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-047",
   "name": "No repeat requests for data already held in another register",
   "description": "Member States shall ensure that a company forming a company or registering a branch in another Member State is not subject to requests for documents and information available in the register of the Member State where it is registered.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-048",
   "name": "EU Company Certificate obtainable electronically and via BRIS",
   "description": "Member States shall ensure that the EU Company Certificate can be obtained from the register upon an application by electronic or by paper means, and that its electronic version can also be obtained through the system of interconnection of registers.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-049",
   "name": "Electronic filing agent authorised by digital EU power of attorney",
   "description": "The EU central interface shall verify automatically the digital EU power of attorney used to authorise an electronic filing agent to sign documents and submit forms on behalf of the EU Inc.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-050",
   "name": "Secure interface to local, external or remote QSCD",
   "description": "The European Business Wallet solution shall securely interface with at least one of the following: a local, an external or a remotely managed qualified signature or seal creation device.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-051",
   "name": "Signing application signs user and relying party data",
   "description": "The signature creation application used by a European Business Wallet unit shall be able to sign or seal data provided by wallet users and data provided by relying parties.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-052",
   "name": "Trust mark no longer shown after unit revocation",
   "description": "Where the wallet provider has revoked a wallet unit attestation, it shall ensure that the trust mark is no longer displayed by the corresponding wallet unit.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-053",
   "name": "Wallet tells the user about revocations it finds",
   "description": "When the wallet instance finds that it, a secure device or keystore it uses, a PID or an attestation has been revoked, it shall notify the user.",
   "ebw:category": "FUN",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-054",
   "name": "Transaction data is carried in the presentation",
   "description": "A wallet that receives transaction data in a presentation request shall include a representation or reference to that data in the presentation, or shall return an error where it does not support transaction data.",
   "ebw:category": "FUN",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/specs/openid-4-verifiable-presentations-1_0.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-055",
   "name": "Role-based wallet authorisations can be managed and revoked by the owner",
   "description": "The European Business Wallet shall enable the owner to manage and revoke authorisations of its users, including authorisations associated to roles for access to and operation of the wallet.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-056",
   "name": "Owner can check the validity status of its own wallet unit",
   "description": "The provider of European Business Wallets shall give the owner a means to check the current validity status of the owner's own wallet unit attestation.",
   "ebw:category": "FUN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-057",
   "name": "Wallet supports at least one remote qualified signing option",
   "description": "The wallet provider shall ensure that its wallet solution supports at least one of the following options for remote qualified electronic signature creation: authentication to a signature web portal of the trust service provider, creation channelled by the wallet unit, or creation channelled by a relying party.",
   "ebw:category": "FUN",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-058",
   "name": "Owner withdraws a user authorisation to use keys",
   "description": "The wallet provider shall enable the wallet owner to withdraw the authorisation of a named user to use any private key of the wallet unit and to deactivate a key held on a device that the user holds.",
   "ebw:category": "FUN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-059",
   "name": "Owner replaces the seal creation device or trust service provider",
   "description": "The wallet provider shall enable the owner to replace the qualified seal or signature creation device, or the trust service provider, linked to a wallet unit with another one without replacing the wallet unit.",
   "ebw:category": "FUN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-fun-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-FUN-060",
   "name": "Provider supplies owner name, identifier, address and country to the Commission",
   "description": "Providers of European Business Wallets shall provide to the Commission, upon the issuance of a European Business Wallet to an owner, the official name of the owner as stated in the national register, the unique identifier, the unique digital address or addresses and the country of establishment.",
   "ebw:category": "FUN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-001",
   "name": "Update of the trusted list after granting status",
   "description": "When granting qualified status, the supervisory body shall inform the body referred to in Article 22(3) for updating the trusted lists not later than three months after the trust service provider's notification under Article 21(1).",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-002",
   "name": "Provider establishment and control",
   "description": "A European Business Wallet shall be provided only by a provider that is established in the Union and not under third-country control.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-003",
   "name": "Notify validation mechanisms to the Commission",
   "description": "The provider of European Business Wallets shall notify the Commission without undue delay of the mechanism for validating owner identification data and of the mechanism for validating the authenticity and validity of wallets.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-004",
   "name": "Supervisory body reports list changes within 24 hours",
   "description": "Supervisory bodies shall inform the Commission of any changes to the information provided on notified providers within 24 hours of becoming aware of them.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-005",
   "name": "Removal of non-compliant provider from list",
   "description": "The supervisory body shall revoke the inclusion of a provider in the list where the provider no longer meets the requirements or has failed to comply with its obligations.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-006",
   "name": "Trust service provider liability for damage",
   "description": "The trust service provider shall be liable for damage caused intentionally or negligently to any natural or legal person due to a failure to comply with the obligations under the Regulation.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-007",
   "name": "Presumed negligence of qualified providers",
   "description": "The qualified trust service provider shall carry the burden of proving that damage occurred without its intention or negligence.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-008",
   "name": "Advance notice of service use limitations",
   "description": "The trust service provider shall inform its customers in advance of the limitations on the use of its services in a form recognisable to third parties to limit its liability.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-009",
   "name": "Administrative fines for trust service infringements",
   "description": "Member States shall ensure that infringements by trust service providers face to administrative fines of a maximum of at least EUR 5 000 000 for natural persons, or EUR 5 000 000 or 1 % of worldwide annual turnover (legal persons), whichever is higher.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-010",
   "name": "Withdrawal of status communicated for trusted list update",
   "description": "The supervisory body shall inform the qualified trust service provider and the body responsible for the trusted lists of the withdrawal of qualified status.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-011",
   "name": "Notification of intent to provide a qualified service",
   "description": "The trust service provider intending to start a qualified trust service shall notify the supervisory body together with a conformity assessment report.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-012",
   "name": "Supervisory decision on qualified status within three months",
   "description": "The supervisory body shall grant qualified status and inform the trusted list body not later than three months after notification where the provider complies, or otherwise inform the provider of the reasons for delay.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-013",
   "name": "Member State notification of trusted list details",
   "description": "The Member State shall notify the Commission without undue delay of the body responsible for its trusted list, the publication location, the signing or sealing certificates and any changes.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-014",
   "name": "Advance notice of service changes and cessation",
   "description": "The qualified trust service provider shall inform the supervisory body at least one month before any change to its qualified services and at least three months before ceasing them.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-015",
   "name": "Financial resources or liability insurance",
   "description": "The qualified trust service provider shall maintain sufficient financial resources or obtain appropriate liability insurance for the risk of liability for damages.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-016",
   "name": "Public issuers equivalent to qualified providers",
   "description": "The Member State shall ensure that public sector bodies issuing attestations meet a level of reliability and trustworthiness equivalent to qualified trust service providers under Article 24.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-017",
   "name": "Supervisory body informs of significant breaches",
   "description": "The supervisory body shall inform competent NIS2 authorities of significant security breaches and shall inform the public or require the provider to do so where disclosure is in the public interest.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-018",
   "name": "Supervisor verifies termination plans",
   "description": "The supervisory body shall verify the existence and correct application of provisions on termination plans, including how information is kept accessible.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-019",
   "name": "Annual supervisory activity report",
   "description": "By 31 March each year, each supervisory body shall submit to the Commission a report on its main activities in the previous calendar year.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-020",
   "name": "Supervisory remedy and suspension of wallets",
   "description": "Where the wallet provider does not remedy a failure, the supervisory body may order suspension or cessation of the wallet and shall inform other bodies, the Commission, relying parties and users without undue delay.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-021",
   "name": "Suspension of relying party registration for misuse",
   "description": "The supervisory body shall be able to suspend or cancel the registration and inclusion of relying parties in the Article 5b(7) mechanism in case of illegal or fraudulent use of the wallet.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-022",
   "name": "Registrar rejects unverifiable registrations",
   "description": "Where the registrar cannot verify the required information, entitlements or power of attorney against supporting documentation or authentic sources, the registrar shall reject the registration.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-023",
   "name": "Notify within 24 hours of relying party suspension",
   "description": "When a registration of a wallet-relying party is suspended or cancelled, the registrar shall inform the access certificate provider, the registration certificate provider and the relying party without undue delay and within 24 hours, including reasons and redress options.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-024",
   "name": "Wallet unit provided to one specific owner",
   "description": "The European Business Wallet provider shall provide each European Business Wallet unit to a specific European Business Wallet owner.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-025",
   "name": "Inform representatives of the right to request revocation",
   "description": "The European Business Wallet provider shall inform authorised representatives of the owner, in a clear, user-friendly, concise and accessible manner, of their right to request revocation of their wallet unit attestation.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-026",
   "name": "Inform owners and users of the right to request revocation",
   "description": "The European Business Wallet provider shall inform owners and their authorised European Business Wallet users of their right to request revocation of their European Business Wallet unit attestation.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-027",
   "name": "Mandatory EUDIW issuance limited to natural persons",
   "description": "Each Member State shall provide at least one European Digital Identity Wallet to natural persons, the mandatory issuance relating only to natural persons.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-028",
   "name": "Wallet authorisations do not create legal powers",
   "description": "The European Business Wallet provider shall treat authorisations granted through the wallet as technical and as not creating, limiting or otherwise affecting any power of attorney or legal mandate.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-029",
   "name": "Repeal or suspend third-country equivalence",
   "description": "Where available information reveals that third-country assurances can no longer be considered equivalent, the Commission shall, to the extent necessary, repeal, amend or suspend the equivalence act by an implementing act.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-030",
   "name": "Notify supervisory body of third-country wallet requests",
   "description": "Where an economic operator established outside the Union requests a European Business Wallet, the provider of European Business Wallets shall notify the request to the supervisory body of the Member State in which the provider is notified.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-031",
   "name": "Member State checks for duplicate third-country registrations",
   "description": "Member States shall cooperate to ensure that providers of owner identification data can verify that an economic operator established outside the Union has not yet been issued owner identification data.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-032",
   "name": "Supervisory cooperation on third-country uniqueness",
   "description": "The supervisory body shall cooperate with the authorities designated under Article 46b of Regulation (EU) No 910/2014 to ensure that economic operators established outside the Union are issued only one set of owner identification data and one unique identifier.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-033",
   "name": "Recognised identification means made public",
   "description": "Member States shall make publicly available all identification means they recognise for online company procedures.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-034",
   "name": "Physical presence only case by case on suspected falsification",
   "description": "Member States shall ensure that the physical presence of an applicant is required only on a case-by-case basis where there are reasons to suspect identity falsification, and that all other procedure steps can be completed online.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-035",
   "name": "Companies to file changes within 15 working days",
   "description": "Member States shall ensure that any changes to the documents and information regarding companies are filed with the register within a period not exceeding 15 working days from the date the changes were made.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-036",
   "name": "Rejection of unconfirmed documents only after register verification",
   "description": "The requesting authority shall decide not to accept a register document or EU Company Certificate only if the register from which it requested information does not confirm its origin or authenticity, and shall notify the submitter within 10 working days of the reply.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-037",
   "name": "Self-assessment report instead of certification",
   "description": "An applicant for notification as a provider of European Business Wallets shall demonstrate conformity with the requirements of Articles 5, 6 and 7 and the Annex through a self-assessment report.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-038",
   "name": "Risk assessment of the whole wallet solution",
   "description": "An applicant for notification as a provider of European Business Wallets shall perform a risk assessment covering the wallet solution as a whole, including risks from design, development, deployment, operation, maintenance, interoperability, dependencies and termination.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-039",
   "name": "Update the self-assessment every 24 months or on trigger",
   "description": "The provider of European Business Wallets shall update its self-assessment every 24 months, and immediately where a significant incident occurred, a substantial change was made to architecture, security functions, cryptographic components, critical suppliers or core functionalities, a function affecting security, validity, authenticity or portability was suspended, revoked or materially modified, or the risk assessment identifies a new risk.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-040",
   "name": "Document the per-issuer index reuse option",
   "description": "The wallet provider shall document in its privacy policy whether it uses the per-issuer reuse option for wallet instance revocation.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-041",
   "name": "Policy for issuing and managing instance and key attestations",
   "description": "The wallet provider shall have a policy governing all aspects of the issuance and management of wallet instance attestations and key attestations, distinguishing instance attestations, key attestations for secure devices and key attestations for keystores.",
   "ebw:category": "GOV",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-042",
   "name": "No units provided or activated under a suspended wallet solution",
   "description": "Member States shall ensure that no wallet units are provided, used or activated under a suspended wallet solution.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-043",
   "name": "Evaluate revoking unit attestations within 24 hours of suspension",
   "description": "Member States shall, no later than 24 hours after suspending a wallet solution, evaluate whether revoking the wallet unit attestations of the affected units, or any other additional remedy, is necessary.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-044",
   "name": "Withdraw and revoke an unremedied solution within 72 hours",
   "description": "Where a security breach leading to the suspension of a wallet solution is not remedied within three months, the Member State shall ensure the solution is withdrawn and its validity revoked without undue delay and in any event within 72 hours after the three months expired.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-045",
   "name": "Public policy on PID validity status management",
   "description": "Each provider of person identification data shall have written and publicly accessible policies relating to validity status management, including the conditions under which the data can be revoked without delay.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-046",
   "name": "No BPN for natural persons or hierarchy elements",
   "description": "The BPN issuing organisation shall not issue a BPNL, BPNS or BPNA for a natural person who acts for a legal entity and is not a legal entity on their own.",
   "ebw:category": "GOV",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-047",
   "name": "OSP collects name and address with country",
   "description": "The onboarding service provider shall collect at least the company name and the full address including country of the prospective participant such that the legal entity can be unambiguously identified.",
   "ebw:category": "GOV",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-048",
   "name": "CSP-B checks that the participant is not already onboarded",
   "description": "The core service provider-B shall verify that the prospective participant is not already onboarded.",
   "ebw:category": "GOV",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-049",
   "name": "Revocation authority for mandate attestations is set by law",
   "description": "Only entities authorised under applicable legislation shall revoke a power of attorney or power of representation attestation.",
   "ebw:category": "GOV",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-050",
   "name": "Self-assessment states the custody models and device evidence",
   "description": "An applicant for notification as a European Business Wallet provider shall state in its self-assessment report, for each custody model it offers, the secure cryptographic device used and the evidence of the evaluation of that device.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-051",
   "name": "Key-holding parties meet the establishment condition",
   "description": "A wallet provider shall ensure that any party that operates a hardware security module or a remote device holding private keys of its wallet units on its behalf is established in the Union and is not subject to control by a third country or a third-country entity.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-052",
   "name": "Implementing act on unique identifiers within one year",
   "description": "The Commission shall, by means of implementing acts adopted within one year after entry into force of the Regulation, establish specifications, requirements and procedures for the unique identifier created where no European Unique Identifier exists, including measures ensuring that no owner is attributed more than one unique identifier.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-053",
   "name": "Assessment criteria before recognising a third-country wallet framework",
   "description": "Before adopting an implementing act that recognises a third-country solution, system or framework as equivalent, the Commission shall assess it, taking into account at least data protection standards, compliance with cybersecurity requirements and the independence of the third-country system and its providers from the control of high-risk governments.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-054",
   "name": "Supervisory body as liaison for owner identification data providers",
   "description": "The national supervisory body shall act as the main liaison office for providers of owner identification data, facilitating access to information from relevant national authorities and registries where necessary for issuing owner identification data and unique identifiers.",
   "ebw:category": "GOV",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-055",
   "name": "Segregation of duties in access rights",
   "description": "Where the wallet owner is a financial entity, it shall include in its access control policy the segregation of duties designed to prevent unjustified access to critical data and the allocation of combinations of access rights that may be used to circumvent controls.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-056",
   "name": "Trust service provider segregates conflicting duties",
   "description": "Where the wallet provider operates as a trust service provider, it shall segregate conflicting duties and areas of responsibility to reduce opportunities for unauthorised or unintentional modification or misuse of its assets.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-gov-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-GOV-057",
   "name": "Limit generic and shared accounts so that users stay identifiable",
   "description": "Where the wallet owner is a financial entity, its access control policy shall include a provision on user accountability that limits, to the extent possible, the use of generic and shared user accounts and ensures that users are identifiable for the actions performed.",
   "ebw:category": "GOV",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-001",
   "name": "Issuance and presentation protocols in the WE BUILD pilot",
   "description": "In the WE BUILD pilot, PID/LPID and EAA providers shall implement OpenID4VCI 1.0, relying parties shall implement OpenID4VP 1.0, and wallet providers shall implement both in wallet solutions; proximity flows are out of scope.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://github.com/webuild-consortium/architecture"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-002",
   "name": "Secure sharing with wallets and relying parties",
   "description": "The European Business Wallet shall enable the owner to request and share owner identification data and electronic attestations of attributes in a secured way between European Business Wallets and European Digital Identity Wallets and with relying parties.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-003",
   "name": "Unique digital address per owner",
   "description": "The provider of European Business Wallets shall assign to each owner at least one unique digital address for the qualified electronic registered delivery service and the European Digital Directory.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-004",
   "name": "Owner identification data format and type",
   "description": "The provider of owner identification data shall issue it in a format compliant with a standard listed in Annex II of Implementing Regulation (EU) 2024/2979, as a qualified attestation, a public-sector authentic-source attestation or a Commission attestation depending on issuer type.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-005",
   "name": "Minimum attributes of owner identification data",
   "description": "European Business Wallet owner identification data shall contain at least the official name of the economic operator or public sector body as recorded in the register or official record, and its unique identifier.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-006",
   "name": "EUID as unique identifier where available",
   "description": "Where an economic operator has been attributed a European Unique Identifier, that identifier shall be used as the unique identifier in its owner identification data.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-007",
   "name": "Single unique identifier per owner",
   "description": "Where no European Unique Identifier exists, a unique identifier shall be created per the implementing act, including measures ensuring that no owner is attributed more than one unique identifier.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-008",
   "name": "Directory with API and portal interfaces",
   "description": "The European Digital Directory shall provide a machine-readable interface exposed through an API for automated system-to-system communication and a secure web-based portal for authenticated and authorised users.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-009",
   "name": "Equivalence of third-country wallets",
   "description": "The Commission shall assess equivalence of assurances before adopting an implementing act recognising third-country business wallets, which shall be interoperable with the eIDAS trust framework and support at least identification, authentication and attestation exchange.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-010",
   "name": "Cross-border recognition of qualified services",
   "description": "The Member State shall recognise qualified electronic seals, qualified certificates and qualified electronic attestations of attributes issued in another Member State as equivalent qualified items.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-011",
   "name": "No higher level than qualified signature across borders",
   "description": "The Member State shall not require, for cross-border use of a public sector online service, an electronic signature of a higher security level than the qualified electronic signature.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-012",
   "name": "Qualified seal certificates meet Annex III",
   "description": "The qualified certificate for electronic seals shall meet the requirements of Annex III and shall not be subject to mandatory requirements beyond them.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-013",
   "name": "Conformity-assessed interoperability of delivery services",
   "description": "When providers of qualified electronic registered delivery services agree on interoperability, the framework shall comply with Article 44(1) and its compliance shall be confirmed by a conformity assessment body.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-014",
   "name": "Recognition of public sector authentic source attestations",
   "description": "The Member State shall recognise an attestation of attributes issued by or for a public sector body responsible for an authentic source in another Member State as such an attestation.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-015",
   "name": "Qualified attestation content per Annex V",
   "description": "The qualified electronic attestation of attributes shall contain a qualified indication, issuer data, subject data, attributes, validity period, unique attestation code, the issuer's qualified signature or seal, certificate location and status service location.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-016",
   "name": "No additional mandatory attestation requirements",
   "description": "Qualified electronic attestations of attributes shall not be subject to any mandatory requirement in addition to those of Annex V.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-017",
   "name": "Public sector attestation content and certified attributes",
   "description": "The public sector body issuing an attestation shall include the Annex VII content and use a qualified certificate indicating its legal basis as responsible for the authentic source and data identifying that source.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-018",
   "name": "Wallet interface of public sector attestation issuers",
   "description": "The public sector body issuing electronic attestations of attributes shall provide an interface with European Digital Identity Wallets.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-019",
   "name": "Wallet interface of qualified attestation providers",
   "description": "The provider of qualified electronic attestations of attributes shall provide an interface with European Digital Identity Wallets.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-020",
   "name": "Public catalogue of attributes and schemes",
   "description": "The Commission shall publish the sealed catalogue of attributes and the catalogue of attestation schemes publicly, free of charge, without authentication, in machine-readable and human-readable form with a search function.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-021",
   "name": "MCP server publishes protected resource metadata",
   "description": "Where the wallet or an agent exposes an MCP server over an HTTP-based transport with authorization, the MCP server shall implement OAuth 2.0 Protected Resource Metadata (RFC 9728).",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-022",
   "name": "MCP client discovers authorization server via metadata",
   "description": "Where the wallet or an agent acts as an MCP client with authorization, the MCP client shall use OAuth 2.0 Protected Resource Metadata to discover the authorization server.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-023",
   "name": "Agent Card available at discovery location",
   "description": "Where the wallet or an agent implements A2A as a server, it shall make an Agent Card available describing its identity, capabilities, skills and interaction requirements.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-024",
   "name": "Agent Card canonicalised before signing",
   "description": "Where the wallet or an agent signs an A2A Agent Card, it shall canonicalise the card content with the JSON Canonicalization Scheme (RFC 8785) before signing and exclude the signatures field.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-025",
   "name": "Delegation expressed with the act claim",
   "description": "Where the wallet or an agent represents delegation in a JWT, the token shall use the act (actor) claim to identify the acting party to whom authority has been delegated.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc8693"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-026",
   "name": "Agent mandates as structured authorization details",
   "description": "Where the wallet or an agent obtains OAuth tokens for transaction-specific authority, the request shall express the authority as authorization_details (RFC 9396) rather than only coarse scopes.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc9396"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-027",
   "name": "Mandate interoperability across wallets",
   "description": "The implementing acts shall cover interoperability mechanisms for mandates and delegations across European Business Wallets.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-028",
   "name": "Unknown authorisation detail types refused",
   "description": "An authorisation server shall refuse to process any authorisation details whose type is unknown or that do not conform to the definition of their type.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc9396"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-029",
   "name": "Delegation chain represented as nested actors",
   "description": "Where authority passes through several actors, the token or mandate shall represent the chain with the current actor outermost and prior actors nested within it.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc8693"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-030",
   "name": "Representation attestation rulebooks limit authority",
   "description": "The scheme provider of a representation attestation rulebook shall specify the unique attestation type and the attributes defining the validity period, the nature of the representation and the operations the representative is authorised to perform.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-031",
   "name": "Wallets support the listed attestation formats",
   "description": "The wallet provider shall ensure that the wallet solution supports the usage of person identification data and electronic attestations of attributes issued in compliance with the list of standards in Annex II.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-032",
   "name": "Listed formats are ETSI TS 119 472-1 clauses 2 to 6",
   "description": "The issuer of an attestation shall use a format conforming to clauses 2 to 6 of ETSI TS 119 472-1 V1.2.1 (2026-02), which cover the SD-JWT VC and ISO/IEC mdoc realisations.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-033",
   "name": "Attestations to wallet units comply with a listed standard",
   "description": "The provider of an electronic attestation of attributes issued to a wallet unit shall comply with at least one of the standards set out in Annex II of Implementing Regulation (EU) 2024/2979.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-034",
   "name": "Support W3C VCDM once profiles are available",
   "description": "When profiles on the W3C VCDM format are available, the wallet provider shall support that format in the wallet.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-035",
   "name": "QEAA and PuB-EAA rulebooks use mdoc or SD-JWT VC",
   "description": "The scheme provider of a rulebook for a qualified or public sector attestation shall specify that one or both of the ISO/IEC 18013-5 format and the SD-JWT VC format must be used.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-036",
   "name": "Non-qualified EAA rulebooks may add W3C VCDM v2.0",
   "description": "The scheme provider of a rulebook for a non-qualified attestation shall specify one or more of the ISO/IEC 18013-5 format, the SD-JWT VC format and the W3C VCDM v2.0 format.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-037",
   "name": "W3C VCDM rulebooks reference approved disclosure specs",
   "description": "If a rulebook allows W3C VCDM v2.0, the scheme provider shall reference documents, approved by an EU standardisation body or the Cooperation Group, specifying how attributes are requested and selectively disclosed.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-038",
   "name": "Rulebooks needing offline presentation require mdoc",
   "description": "Where an attestation type must be presentable in proximity without the internet, the rulebook shall specify issuance in the ISO/IEC 18013-5 mdoc format.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-039",
   "name": "Unique attestation type value in a rulebook",
   "description": "The scheme provider of a rulebook shall specify a value for the attestation type that is unique within the scope of the wallet ecosystem.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-040",
   "name": "Attribute semantics defined independently of encoding",
   "description": "The scheme provider of a rulebook shall first describe the semantics of each attribute in an encoding-independent manner and then specify the format-specific encoding.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-041",
   "name": "mdoc attributes defined in a unique namespace",
   "description": "The rulebook shall define each attribute of an ISO/IEC 18013-5 attestation within an attribute namespace that fully defines identifier, syntax and semantics and has an identifier unique in the ecosystem.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-042",
   "name": "Rulebook states disclosure mode for every SD-JWT VC claim",
   "description": "The scheme provider of a rulebook using SD-JWT VC shall specify for all claims whether an attestation provider must, may or must not make that claim selectively disclosable.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-043",
   "name": "Catalogue request carries namespace, identifier and version",
   "description": "The requester of a catalogue entry for an attribute shall provide a namespace unique within the catalogue and an attribute identifier, unique within the namespace, together with the version of the attribute.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-044",
   "name": "Catalogue request carries semantic description and data type",
   "description": "The requester of a catalogue entry for an attribute shall provide a semantic description and the data type of the attribute.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-045",
   "name": "Scheme request declares attestation formats",
   "description": "The scheme owner requesting a catalogue entry shall state the format or formats of the attestations within the scope of the scheme.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-046",
   "name": "Scheme request declares namespaces, identifiers, semantics and types",
   "description": "The scheme owner requesting a catalogue entry shall state the namespaces, attribute identifiers, semantic descriptions and data types of each attribute in the scheme.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-047",
   "name": "Scheme attributes identifiable by unique identifiers",
   "description": "A scheme requested for inclusion in the catalogue shall contain only attributes that are identifiable based on unique identifiers.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-048",
   "name": "Commission maintains owner identification scheme in the catalogue",
   "description": "The Commission shall establish and maintain an attestation scheme for European Business Wallet owner identification data and list it in the catalogue of schemes.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-049",
   "name": "SD-JWT VC attestations carry vct pointing to Type Metadata",
   "description": "The issuer of an SD-JWT VC attestation shall include the vct claim and point it to the SD-JWT VC Type Metadata.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/standards"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-050",
   "name": "Commission attributes the unique identifier of Union entities",
   "description": "Where a public sector body is a Union entity, the Commission shall create and attribute a unique identifier to that Union entity.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-051",
   "name": "Equivalence of third-country frameworks by implementing act",
   "description": "Where the Commission recognises a third-country framework as equivalent to European Business Wallets, the systems under that framework shall be interoperable with the trust framework of Regulation (EU) 910/2014 and shall support at least identification, authentication and the exchange of electronic attestations of attributes.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-052",
   "name": "EU Company Certificate contains the EUID",
   "description": "The EU Company Certificate for limited liability companies shall include the EUID of the company, the registration number and the Member State where the company is registered.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-053",
   "name": "Legal person data in person identification data",
   "description": "The provider of person identification data for a legal person shall include the current legal name and a unique identifier constructed in accordance with the technical specifications for cross-border identification.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-054",
   "name": "LEI and other optional identifiers in legal person data",
   "description": "Where a provider of person identification data for a legal person includes a Legal Entity Identifier, it shall be the LEI referred to in Implementing Regulation (EU) 2022/1860, alongside the other optional elements (VAT, tax reference, EUID, EORI, excise number).",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-055",
   "name": "One EORI number per person",
   "description": "The competent customs authority shall assign only one EORI number to each person.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32015R2447"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-056",
   "name": "LEI as legal person identity type in certificates",
   "description": "When the legal person semantics identifier is used, an LEI in the organizationIdentifier attribute shall be prefixed LEI with the country code XG followed by the LEI.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941201/01.05.01_60/en_31941201v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-057",
   "name": "Core owner identification attributes presented atomically",
   "description": "The holder shall present the core owner identification data attributes atomically, without selective disclosure.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-058",
   "name": "Receiving register retrieves data via interconnection of registers",
   "description": "Member States shall ensure that the register where the company is being formed retrieves documents and information by means of exchange of information through the system of interconnection of registers.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-059",
   "name": "EUID composition",
   "description": "The EUID shall comprise, at least, elements making it possible to identify the Member State of the register, the domestic register of origin and the company number in that register.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-060",
   "name": "EUID structure under ISO 6523 with optional verification digit",
   "description": "The structure of the EUID shall be compliant with ISO 6523 and shall contain a mandatory country code, a mandatory register identifier and a mandatory registration number, and may contain a verification digit.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32021R1042"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-061/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-061",
   "name": "EUID identifies companies and branches in register exchanges",
   "description": "The EUID shall be used to unequivocally identify companies and branches for the exchange of information between registers via the platform.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32021R1042"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-062/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-062",
   "name": "Mutual accessibility of interconnections by unique identifier",
   "description": "The Commission shall adopt implementing acts on the technical specifications and detailed list of data defining mutual accessibility between the system of interconnection of registers, the beneficial ownership registers interconnection and the insolvency registers interconnection, covering use of the unique company identifier.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-063/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-063",
   "name": "Multilingual EU Company Certificate template published",
   "description": "The Commission shall publish the multilingual template for the EU Company Certificate on the European e-Justice portal in all official languages of the Union.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-064/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-064",
   "name": "Implementing acts on EUCC and power of attorney wallet profile",
   "description": "The Commission shall adopt implementing acts by 31 July 2026 establishing the technical specifications, including compatibility with the European Digital Identity Wallet, the taxonomy and the multilingual template for the EU Company Certificate and for the digital EU power of attorney.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-065/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-065",
   "name": "Register copies and extracts compatible with the EUDI Wallet",
   "description": "Member States shall ensure that electronic copies and extracts of documents and information provided by the register are compatible with the European Digital Identity Wallet.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-066/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-066",
   "name": "Documents available through BRIS in a standard message format",
   "description": "Member States shall ensure that the documents and information referred to in Articles 14, 14a, 19(2), 19a(2) and 19b are available through the system of interconnection of registers in a standard message format and accessible by electronic means.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-067/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-067",
   "name": "EU Inc certificate and power of attorney fit business wallets",
   "description": "The EU Company Certificate and the digital EU power of attorney of an EU Inc. shall be compatible with the European Business Wallets, where available.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-068/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-068",
   "name": "Core functionality specifications refer to accessibility requirements",
   "description": "The standards and specifications defined in the implementing acts for the core functionalities of European Business Wallets shall refer to accessibility requirements.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-069/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-069",
   "name": "Authority portals use EN 301 549 V3.2.1 as conformance basis",
   "description": "Public sector bodies shall use the harmonised standard EN 301 549 V3.2.1 (2021-03), whose reference is published in the Official Journal, as the basis for conformity of their websites and mobile applications with the Web Accessibility Directive.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dec_impl/2021/1339/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-070/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-070",
   "name": "Integrated signature application supports remote QSCD API",
   "description": "Where a signature creation application relies on remote qualified signature creation devices and is integrated into the wallet back-end, it shall support the application programming interface set out in the implementing acts.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-071/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-071",
   "name": "Wallets integrate one specific qualified registered delivery service",
   "description": "The European Business Wallet shall integrate and support the use of a specific qualified electronic registered delivery service in accordance with Articles 43 and 44 of Regulation (EU) No 910/2014.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-072/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-072",
   "name": "Delivery channel based on open royalty-free standards",
   "description": "The Commission shall, by implementing act, ensure that the qualified electronic registered delivery service chosen as the mandatory channel is based on open, publicly available and royalty-free standards.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-073/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-073",
   "name": "Authorities issue owner identification data per implementing acts",
   "description": "Competent authorities shall ensure that owner identification data issued to wallet units complies with the technical specifications set out in the implementing acts.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-074/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-074",
   "name": "Signature creation application supports the listed interface",
   "description": "The signature creation application used by a wallet unit shall support at least the application programming interface referred to in Annex IV of Implementing Regulation (EU) 2024/2979.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-075/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-075",
   "name": "Signing interface specified by ETSI TS 119 432",
   "description": "The application programming interface of the signature creation application of a wallet unit shall comply with ETSI TS 119 432 v1.3.1, clauses 6.4.3, A.6, A.7 and A.8.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-076/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-076",
   "name": "Wallet provider uses token status lists for instance and key status",
   "description": "The wallet provider shall use Token Status Lists as the revocation mechanism for both key attestations and wallet instance attestations.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-077/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-077",
   "name": "Revocation method for mdoc attestations",
   "description": "The provider of person identification data, of qualified attestations or of public-sector attestations issued in the mdoc format shall use one of the following revocation methods: short-lived attestations of 24 hours or less, an attestation status list, or an attestation revocation list.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-078/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-078",
   "name": "Relying party that checks status supports both mdoc mechanisms",
   "description": "A wallet-relying party that needs to verify the revocation status of person identification data or attestations in the mdoc format shall support both the attestation status list mechanism and the attestation revocation list mechanism.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-079/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-079",
   "name": "Status token for mdoc revocation carries an expiry",
   "description": "The token carrying the revocation list or status list of an mdoc attestation shall contain an expiry claim.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-080/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-080",
   "name": "Discovery of recipients and delivery capabilities",
   "description": "Where providers of electronic registered delivery interoperate under the reference standards of Implementing Regulation (EU) 2025/1944, they shall bind receiver identification to the OASIS Business Document Metadata Service Location specification and capability discovery to the OASIS Service Metadata Publishing specification.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319500_319599/3195220403/01.01.01_60/en_3195220403v010101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-081/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-081",
   "name": "Presentation requests use the certificate-hash client identifier",
   "description": "A wallet-relying party shall identify itself in a presentation request with the x509_hash client identifier prefix and sign the request.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11947202/01.02.01_60/ts_11947202v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-082/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-082",
   "name": "Relayed delivery messages are signed and encrypted",
   "description": "The sending provider shall sign and encrypt every AS4 message that relays an electronic registered delivery message to another provider.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319500_319599/3195220401/01.02.01_60/en_3195220401v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-083/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-083",
   "name": "Relay between delivery providers uses the push pattern",
   "description": "A provider that relays an electronic registered delivery message over AS4 shall use the push message exchange pattern only.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319500_319599/3195220401/01.02.01_60/en_3195220401v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-084/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-084",
   "name": "BPN registered as an ISO/IEC 6523 identification scheme",
   "description": "The structure of the Business Partner Number shall be registered as an organisation identification scheme under ISO/IEC 6523 with the Registration Authority under an International Code Designator.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0010-BusinessPartnerNumber"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-085/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-085",
   "name": "Wallet identified by a DID using the did:web method",
   "description": "The wallet shall be associated with a Decentralized Identifier following DID v1.0 and using the did:web method.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0149-WalletRequirements"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-086/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-086",
   "name": "BPN-DID resolution service provided by CSP-B",
   "description": "The core service provider-B shall provide the BPN-DID resolution service that maps the BPNL of a legal entity to its DID.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0167-BpnDidResolution"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-087/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-087",
   "name": "BPN-DID resolution only for onboarded legal entities",
   "description": "The BPN-DID resolution service shall provide mapping data exclusively for onboarded legal entities referenced by their BPNLs.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0167-BpnDidResolution"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-088/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-088",
   "name": "A restricted power of attorney states the restricted faculty or service access",
   "description": "Where a power of attorney attestation indicates that the power is restricted, it shall state either the faculty or the service access to which the restriction applies.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-089/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-089",
   "name": "Authorisation states the total number of signatures",
   "description": "A signature application that authorises use of a remote signing credential shall indicate the total number of signatures to authorise.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://cloudsignatureconsortium.org/wp-content/uploads/2023/04/csc-api-v2.0.0.2.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-090/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-090",
   "name": "Signing certificate of a seal identifies the creator of the seal",
   "description": "Where a signature creation application service component is used to create an advanced electronic seal, the signing certificate shall identify the creator of the seal.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943102/01.02.01_60/ts_11943102v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-091/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-091",
   "name": "Unique identifier created on request or on wallet provision",
   "description": "Where an economic operator or public sector body has not been attributed a European Unique Identifier, a unique identifier for owner identification data shall be created upon its request or upon the provision of a European Business Wallet to it, in accordance with the Commission implementing act.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-092/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-092",
   "name": "Register notifications carry alternate identifiers such as the LEI",
   "description": "Register notifications exchanged through the system of interconnection of registers shall provide for zero or more alternate identifiers of the company, such as the Legal Entity Identifier, in addition to the mandatory EUID.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32021R1042"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-093/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-093",
   "name": "EUID given only for companies listed in Annex II",
   "description": "In a first level query on disqualification of a legal entity, the requesting Member State shall give the other registration number of the entity where it is not a company listed in Annex II to Directive (EU) 2017/1132; the EUID is given only for listed companies.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32021R1042"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-094/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-094",
   "name": "Branches of third-country companies disclosed with a unique identifier via BRIS",
   "description": "Member States shall ensure that the unique identifier of the branch of a company from a third country is available free of charge through the system of interconnection of registers.",
   "ebw:category": "INT",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-095/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-095",
   "name": "Owner identification scheme states which attributes are disclosed together",
   "description": "The attestation scheme for owner identification data shall state which attributes, in particular the unique identifier, may be disclosed separately and which only together with other attributes.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-096/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-096",
   "name": "LEI is carried in addition to the unique identifier",
   "description": "Where owner identification data also carries an LEI or another secondary identifier, it shall carry it in addition to, and not in place of, the unique identifier attributed in accordance with Article 9.",
   "ebw:category": "INT",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-097/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-097",
   "name": "EU power of attorney states whether the attorney may delegate onward",
   "description": "The issuer of an EU power of attorney attestation shall include an attribute stating whether the attorney may delegate the granted powers to a third party, with the values allowed, not allowed or limited.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-int-098/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-INT-098",
   "name": "Limited onward delegation lists its limitations",
   "description": "Where an EU power of attorney attestation states that substitution is limited, the issuer shall include the limitation details in the scope of representation powers and shall reject the attestation if they are missing.",
   "ebw:category": "INT",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-001",
   "name": "Compliance with NIS2",
   "description": "The provider of European Business Wallets shall comply with the requirements of Directive (EU) 2022/2555.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-002",
   "name": "Legal effect of electronic signatures",
   "description": "An electronic signature shall not be denied legal effect and admissibility as evidence in legal proceedings solely because it is electronic or not qualified, and a qualified electronic signature shall have the equivalent legal effect of a handwritten signature.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-003",
   "name": "Presumption for qualified electronic seals",
   "description": "The qualified electronic seal shall enjoy the presumption of integrity of the linked data and of correctness of the origin of that data.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-004",
   "name": "Legal effect of electronic attestations of attributes",
   "description": "A qualified electronic attestation of attributes, and an attestation of attributes issued by or on behalf of a public sector body responsible for an authentic source, shall have the same legal effect as lawfully issued attestations in paper form.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-005",
   "name": "No combination of attestation service personal data",
   "description": "The provider of attestation services shall not combine personal data from the provision of those services with personal data from any other services of its own or its commercial partners.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-006",
   "name": "Registrars keep registration records for 10 years",
   "description": "The registrar shall keep records of the registered information, of the issuance of access and registration certificates, and of subsequent changes, for 10 years.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-007",
   "name": "Data protection by design in wallet processing",
   "description": "The controller shall, at the time of determining the means for processing and at the time of the processing itself, implement appropriate technical and organisational measures, such as pseudonymisation, designed to implement data-protection principles, such as data minimisation, effectively.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-008",
   "name": "Minimal personal data processing by default",
   "description": "The controller shall implement appropriate technical and organisational measures ensuring that, by default, only personal data necessary for each specific purpose of the processing are processed, as to amount collected, extent of processing, storage period and accessibility.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-009",
   "name": "No indefinite public exposure of personal data",
   "description": "The controller shall implement appropriate technical and organisational measures ensuring that, by default, personal data are not made accessible without the individual's intervention to an indefinite number of natural persons.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-010",
   "name": "Present only attributes necessary for the purpose",
   "description": "When a wallet presents an attestation containing personal data, the wallet shall disclose only the attributes that are adequate, relevant and limited to what is necessary for the purpose stated by the relying party.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-011",
   "name": "Retention limits for personal data held by wallet services",
   "description": "The wallet provider shall define and enforce retention periods so that personal data in transaction logs, message records and backups are kept in identifiable form no longer than necessary for their purposes.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-012",
   "name": "Respond to data subject requests within one month",
   "description": "The controller shall provide information on action taken on a request under Articles 15 to 22 to the data subject without undue delay and in any event within one month of receipt, which may be extended by two further months where necessary.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-013",
   "name": "Erasure capability for personal data in provider systems",
   "description": "The wallet provider shall design provider-held stores and registries so that personal data can be erased without undue delay where an erasure ground in Article 17(1) applies.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-014",
   "name": "Export wallet data in a machine-readable format",
   "description": "Where processing is based on consent or contract and carried out by automated means, the wallet provider shall give the data subject their provided personal data in a structured, commonly used and machine-readable format and, where technically feasible, transmit them directly to another controller.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-015",
   "name": "Safeguards for solely automated decisions with legal effect",
   "description": "Where a decision based solely on automated processing produces legal or similarly significant effects on a data subject and is necessary for a contract or based on explicit consent, the controller shall implement safeguards, at least human intervention, expressing a view and contesting it.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-016",
   "name": "Record of processing activities",
   "description": "Each controller and processor operating wallet services shall maintain a written record of processing activities containing the information listed in Article 30 and make it available to the supervisory authority on request.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-017",
   "name": "Encryption and pseudonymisation of personal data",
   "description": "The wallet provider and its processors shall implement, as appropriate to the risk, pseudonymisation and encryption of personal data they store or transmit.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-018",
   "name": "Notify the supervisory authority of breaches within 72 hours",
   "description": "When a personal data breach is likely to result in a risk to natural persons, the controller shall notify the competent supervisory authority without undue delay and, where feasible, not later than 72 hours after becoming aware of it.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-019",
   "name": "Communicate high-risk breaches to data subjects",
   "description": "When a personal data breach is likely to result in a high risk to natural persons, the controller shall communicate it to the data subject without undue delay in clear and plain language.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-020",
   "name": "Data protection impact assessment before wallet processing",
   "description": "Before starting processing that is likely to result in a high risk to natural persons, the controller shall carry out an assessment of the impact of the envisaged processing operations on the protection of personal data.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-021",
   "name": "Qualified trust service providers are essential entities",
   "description": "Each qualified trust service provider shall be treated as an essential entity under NIS2 regardless of its size.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-022",
   "name": "Management approval and oversight of cybersecurity measures",
   "description": "The management body of an essential or important entity, including a trust service provider, shall approve the cybersecurity risk-management measures taken to comply with Article 21, oversee their implementation and can be held liable for infringements of that Article.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-023",
   "name": "Risk analysis and information system security policies",
   "description": "The trust service provider shall take appropriate and proportionate technical, operational and organisational measures based on an all-hazards approach, including policies on risk analysis and information system security.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-024",
   "name": "Business continuity, backup and disaster recovery",
   "description": "The trust service provider shall maintain business continuity measures, including backup management, disaster recovery and crisis management.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-025",
   "name": "Supply chain security for direct suppliers",
   "description": "An essential or important entity shall address supply chain security in its risk-management measures, taking into account vulnerabilities specific to each direct supplier and service provider and the overall quality of their products and cybersecurity practices, including secure development procedures.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-026",
   "name": "Policies on the use of cryptography",
   "description": "The trust service provider shall maintain policies and procedures regarding the use of cryptography and, where appropriate, encryption.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-027",
   "name": "Trust service providers notify significant incidents within 24 hours",
   "description": "When a significant incident has an impact on the provision of its trust services, the trust service provider shall notify the CSIRT or competent authority without undue delay and in any event within 24 hours of becoming aware of it.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-028",
   "name": "Inform service recipients of significant incidents and threats",
   "description": "An essential or important entity shall, where appropriate, notify recipients of its services without undue delay of significant incidents likely to adversely affect those services and, where applicable, tell recipients potentially affected by a significant cyber threat which measures or remedies they can take.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-029",
   "name": "Return of data in an accessible format on termination",
   "description": "The wallet provider serving a financial entity shall contractually ensure access, recovery and return in an easily accessible format of the entity's data on insolvency, resolution, discontinuation or termination.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-030",
   "name": "Provider assistance during ICT incidents for financial entities",
   "description": "The wallet provider serving a financial entity shall assist the entity when an ICT incident related to the service occurs, at no additional cost or at a cost determined ex ante.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-031",
   "name": "Exit strategy and transition period for critical functions",
   "description": "Where a wallet service supports a critical or important function of a financial entity, the wallet provider shall continue providing the service during a mandatory transition period that allows migration to another provider or in-house solution.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-032",
   "name": "Wallet products meet both CRA and eIDAS security requirements",
   "description": "Where a wallet is a product with digital elements within the scope of the CRA, its manufacturer shall comply with both the essential cybersecurity requirements of the CRA and the specific security requirements of Article 5a of Regulation 910/2014.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-033",
   "name": "Security updates with notification and postponement option",
   "description": "The manufacturer of a wallet that is a product with digital elements shall, where applicable, ensure that vulnerabilities can be addressed through security updates, including automatic security updates enabled by default with an opt-out, update notifications and the option to temporarily postpone them.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-034",
   "name": "Protection from unauthorised access with reporting",
   "description": "The manufacturer of a wallet that is a product with digital elements shall, where applicable, ensure protection from unauthorised access by appropriate control mechanisms, including but not limited to authentication and identity or access management systems, and report on possible unauthorised access.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-035",
   "name": "Confidentiality and integrity of stored and transmitted data",
   "description": "The manufacturer of a wallet that is a product with digital elements shall, where applicable, protect the confidentiality of stored, transmitted or otherwise processed data and protect its integrity against unauthorised manipulation or modification, and report on corruptions.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-036",
   "name": "Software bill of materials for vulnerability management",
   "description": "The wallet provider shall identify and document vulnerabilities and components of the wallet, including a software bill of materials in a commonly used, machine-readable format covering at least top-level dependencies.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-037",
   "name": "Coordinated vulnerability disclosure policy and contact point",
   "description": "The manufacturer of a wallet that is a product with digital elements shall put in place and enforce a policy on coordinated vulnerability disclosure and take measures to facilitate sharing of vulnerability information, including by providing a contact address for reporting vulnerabilities.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-038",
   "name": "Support period of at least five years",
   "description": "The manufacturer shall handle the wallet's vulnerabilities for a support period of at least five years, or the expected use time if shorter, and keep each security update available for 10 years or the remainder of the support period, whichever is longer.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-039",
   "name": "Early warning of actively exploited vulnerabilities within 24 hours",
   "description": "A manufacturer aware of an actively exploited vulnerability in its wallet product shall simultaneously notify the CSIRT designated as coordinator and ENISA via the single reporting platform, submitting an early warning without undue delay and within 24 hours.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-040",
   "name": "Automatic event logging in high-risk AI systems",
   "description": "The provider of a high-risk AI system shall ensure that the system technically allows for the automatic recording of events (logs) over the lifetime of the system.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-041",
   "name": "Human ability to interrupt a high-risk AI system",
   "description": "A high-risk AI system acting with wallet credentials shall allow assigned natural persons to intervene in its operation or interrupt it through a stop mechanism that brings it to a safe state.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-042",
   "name": "Resilience of high-risk AI systems against manipulation",
   "description": "A high-risk AI system acting with wallet credentials shall be resilient against attempts by unauthorised third parties to alter its use, outputs or performance by exploiting vulnerabilities.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-043",
   "name": "Disclose interaction with an AI system",
   "description": "The provider of an AI system intended to interact directly with natural persons shall design it so that those persons are informed that they are interacting with an AI system, unless obvious from context.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-044",
   "name": "Registration of high-risk AI systems in the EU database",
   "description": "Before placing on the market or putting into service a high-risk AI system listed in Annex III, the provider shall register itself and the system in the EU database referred to in Article 71.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-045",
   "name": "Digital EU power of attorney data fields",
   "description": "The digital EU power of attorney template shall include at least data fields about the scope of representation, the person authorised to represent the company and the type of representation.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-046",
   "name": "Digital EU power of attorney authenticated by trust services",
   "description": "Member States shall ensure that the digital EU power of attorney is authenticated by means of trust services referred to in Regulation (EU) No 910/2014 and that its granting, amendment or revocation is compatible for use with the European Digital Identity Wallet.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-047",
   "name": "Acceptance of digital EU power of attorney as evidence",
   "description": "A body within the scope of Directive (EU) 2017/1132 shall accept the digital EU power of attorney as evidence of the authorised person's entitlement to represent the company as specified in the document.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-048",
   "name": "Suspension of a high-risk AI system presenting a risk",
   "description": "When a deployer has reason to consider that use of a high-risk AI system acting with wallet credentials may present a risk within the meaning of Article 79(1), the deployer shall without undue delay inform the provider or distributor and the market surveillance authority and suspend its use.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-049",
   "name": "Same legal effect as in-person or paper action",
   "description": "Where an owner uses a core functionality of the European Business Wallet, the resulting action shall have the same legal effect as if it had been lawfully carried out in person, in paper form or by other compliant means.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-050",
   "name": "Equivalence for sole traders using registered delivery",
   "description": "Where a self-employed person or sole trader uses the qualified electronic registered delivery service under Article 5(3), the resulting action shall have the same legal effect as if carried out in person or in paper form.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-051",
   "name": "Legal effect of Commission-issued owner identification data",
   "description": "Owner identification data issued by the Commission shall have the same legal effect as qualified electronic attestations of attributes and attestations of attributes issued by a public sector body responsible for an authentic source.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-052",
   "name": "No disadvantage for those without a wallet",
   "description": "Access to public and private services shall not be restricted or made disadvantageous to natural or legal persons that do not use European Digital Identity Wallets.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-053",
   "name": "Presumption of integrity and identified sender and addressee",
   "description": "Data sent and received using a qualified electronic registered delivery service shall enjoy the presumption of the integrity of the data, of sending by the identified sender, of receipt by the identified addressee and of the accuracy of date and time.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-054",
   "name": "Recognition of third-country trust services",
   "description": "Trust services provided by trust service providers established in a third country shall be recognised as legally equivalent to qualified trust services only where recognised by an implementing act or by an agreement under Article 218 TFEU.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-055",
   "name": "No legalisation for register documents, EUCC and power of attorney",
   "description": "Member States shall ensure that the EU Company Certificate, the digital EU power of attorney and certified copies and extracts provided by a register are exempted from all forms of legalisation and any similar formality.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-056",
   "name": "EU Inc business communication shows company name and EUID",
   "description": "The EU Inc. business related communication, in digital or paper form, shall contain the company name, EUID, registered office address, digital correspondence address and digital presence address.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-057",
   "name": "Consumer-facing services designed to EAA requirements",
   "description": "Where a service falls under Article 2(2) of Directive (EU) 2019/882, the service provider shall design and provide the service in accordance with the accessibility requirements of that Directive.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-058",
   "name": "Accessibility information for services in terms and conditions",
   "description": "The service provider shall include in its general terms and conditions, or an equivalent document, information assessing how the service meets the accessibility requirements, and shall make that information available to the public in written and oral format, including in a manner accessible to persons with disabilities.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-059",
   "name": "Procedures keep the service accessible over time",
   "description": "The service provider shall ensure that procedures are in place so that the provision of the service remains in conformity with the applicable accessibility requirements, taking changes in the service, in the requirements and in the harmonised standards into account.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-060",
   "name": "Corrective measures and notice on accessibility non-conformity",
   "description": "Where a service does not comply with the applicable accessibility requirements, the service provider shall take the corrective measures necessary to bring it into conformity and shall immediately inform the competent national authorities of the Member States in which the service is provided.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-061/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-061",
   "name": "Demonstrate accessibility conformity to authority on request",
   "description": "Upon a reasoned request from a competent authority, the service provider shall provide all information necessary to demonstrate the conformity of the service with the applicable accessibility requirements and shall cooperate with that authority.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-062/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-062",
   "name": "Document any fundamental-alteration or burden assessment",
   "description": "Where an economic operator relies on fundamental alteration or disproportionate burden, it shall document the assessment, keep the results for five years after the service was last provided, and renew the burden assessment at least every five years.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-063/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-063",
   "name": "Authority websites and apps meet web accessibility principles",
   "description": "Public sector bodies shall take the necessary measures to make their websites and mobile applications more accessible by making them perceivable, operable, understandable and robust.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2016/2102/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-064/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-064",
   "name": "Authority portal publishes an accessibility statement",
   "description": "Public sector bodies shall provide and regularly update an accessibility statement on the compliance of their websites and mobile applications, including a feedback mechanism and a link to the enforcement procedure.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2016/2102/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-065/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-065",
   "name": "Presumption of conformity for access control standards",
   "description": "Compliance with the access control requirements of Annex point 12 shall be presumed where the standards, specifications and procedures set by the implementing acts are met.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-066/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-066",
   "name": "Processor contract for provider processing",
   "description": "Where the wallet provider processes personal data on behalf of an owner acting as controller, the processing shall be governed by a binding contract or other legal act under which the provider processes the data only on documented instructions of the owner.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-067/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-067",
   "name": "Arrangement between joint controllers",
   "description": "Where an owner and a wallet provider jointly determine the purposes and means of a processing operation, they shall in a transparent manner determine their respective responsibilities by an arrangement and make its essence available to the data subject.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-068/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-068",
   "name": "Owner ensures measures for processing by its users",
   "description": "An owner that is the controller shall ensure appropriate technical and organisational measures, including training and information of the users it authorises, so that processing by those users in the wallet complies with the data protection rules.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.edpb.europa.eu/system/files/2023-10/edpb_guidelines_202007_controllerprocessor_final_en.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-069/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-069",
   "name": "Wallet authorisation changes do not alter legal mandates",
   "description": "Granting, changing or revoking an authorisation of a user in the European Business Wallet shall not by itself create, limit or revoke any power of attorney or legal mandate of that user.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-070/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-070",
   "name": "Provider states who is responsible for each key",
   "description": "The wallet provider shall state in its terms of service to the owner which party is responsible for the creation, protection and use of each private key, distinguishing the wallet provider, the owner and any qualified trust service provider.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/discussion-topics/ab-digital-signature-using-wallet/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-071/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-071",
   "name": "Recognition of notified eID means across Member States",
   "description": "Where electronic identification and authentication is required to access an online service of a public sector body, the Member State shall recognise an electronic identification means issued in another Member State under a listed scheme if its assurance level, substantial or high, is equal to or higher than the level the service requires.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-072/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-072",
   "name": "Agreements recognising third-country trust services require equivalent requirements",
   "description": "An agreement under which trust services of a third country are recognised as legally equivalent to qualified trust services shall ensure that the requirements applicable to qualified trust service providers in the Union and their qualified services are met by the third-country providers and services.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-073/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-073",
   "name": "Transfers of personal data to third countries meet Chapter V",
   "description": "Any transfer of personal data to a third country or an international organisation shall take place only if the controller and processor comply with the conditions of Chapter V of Regulation (EU) 2016/679, including for onward transfers.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-074/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-074",
   "name": "Appropriate safeguards where no adequacy decision exists",
   "description": "In the absence of an adequacy decision, a controller or processor shall transfer personal data to a third country or an international organisation only if it has provided appropriate safeguards and enforceable data subject rights and effective legal remedies are available.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-075/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-075",
   "name": "No wallet services to persons listed under EU asset-freeze measures",
   "description": "The provider of European Business Wallets shall not make funds or economic resources available, directly or indirectly, to or for the benefit of natural or legal persons, entities or bodies listed in Annex I to Regulation (EU) No 269/2014, and shall assess whether wallet and owner identification services are economic resources within the meaning of that prohibition.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32014R0269"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-076/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-076",
   "name": "Third-country wallet equivalence does not replace GDPR transfer rules",
   "description": "Where the exchange of attestations of attributes with a third-country wallet or framework recognised under Article 17 involves a transfer of personal data, the controller shall ensure that the conditions of Chapter V of Regulation (EU) 2016/679 are met.",
   "ebw:category": "LEG",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-077/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-077",
   "name": "Delegates of EU Inc. directors are bound by directors' legal obligations",
   "description": "An individual to whom the directors of an EU Inc. company have delegated powers shall adhere to the legal obligations imposed on directors when exercising the delegated powers.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-078/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-078",
   "name": "Several directors of an EU Inc. represent the company jointly by default",
   "description": "Where an EU Inc. company has several directors, the directors shall represent the company jointly.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-079/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-079",
   "name": "Users can remove all data and settings from a product permanently",
   "description": "The manufacturer of a device or software that is a product with digital elements shall, where applicable, ensure that users can securely and easily remove permanently all data and settings and, where the data can be transferred to other products or systems, that the transfer is secure.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-leg-080/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-LEG-080",
   "name": "Device records access to and modification of data, services and functions",
   "description": "The manufacturer of a product with digital elements shall, where applicable, ensure that the product provides security-related information by recording and monitoring relevant internal activity, including access to or modification of data, services or functions, with an opt-out mechanism for the user.",
   "ebw:category": "LEG",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-001",
   "name": "Export of wallet data and records",
   "description": "The European Business Wallet shall enable the export of owner identification data, electronic attestations of attributes, communication logs and interaction records in a structured, commonly used and machine-readable format at the owner's request or on termination of service or revocation of the provider's notification.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-002",
   "name": "Access to a log of all transactions",
   "description": "The European Business Wallet shall enable the owner to access a log of all transactions.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-003",
   "name": "Technical and organisational measures for CIA and interoperability",
   "description": "The provider of European Business Wallets shall implement appropriate technical and organisational measures to ensure the confidentiality, integrity, authenticity, interoperability and availability of its wallets with other business wallets and European Digital Identity Wallets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-004",
   "name": "Directory access limited to owners, representatives and providers",
   "description": "The Commission shall make the European Digital Directory accessible only to owners, their authorised representatives and providers of European Business Wallets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-005",
   "name": "Accessible and plain-language trust services",
   "description": "Providers of electronic identification means, trust services and the end-user products used for them shall make them available in plain and intelligible language, in accordance with the United Nations Convention on the Rights of Persons with Disabilities and the accessibility requirements of Directive (EU) 2019/882.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-006",
   "name": "Trustworthy systems and cryptography",
   "description": "The qualified trust service provider shall use trustworthy systems and products protected against modification that ensure technical security and reliability, including suitable cryptographic techniques.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-007",
   "name": "Protection against forgery and data tampering",
   "description": "The qualified trust service provider shall take appropriate measures against forgery, theft or misappropriation of data and against unauthorised deletion, alteration or rendering data inaccessible.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-008",
   "name": "Remote signature creation data managed only by qualified provider",
   "description": "Generating, managing or duplicating electronic signature creation data shall be carried out only on behalf of and at the request of the signatory by a qualified provider of remote creation device management.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-009",
   "name": "Limited backup of remote signature creation data",
   "description": "The qualified provider managing remote signature creation devices shall duplicate creation data only for back-up, at the same security level as the original and with no more copies than needed for continuity.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-010",
   "name": "Logical separation of attestation service data",
   "description": "The provider of attestation services shall keep personal data relating to the service logically separate from other data it holds.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-011",
   "name": "Functional separation of qualified attestation service",
   "description": "The provider of qualified electronic attestation of attributes services shall implement the service in a manner functionally separate from its other services.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-012",
   "name": "Wallet user authentication before any function",
   "description": "The wallet unit shall not perform any wallet function other than wallet user authentication until the wallet unit has successfully authenticated the wallet user.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-013",
   "name": "Log all wallet transactions including failed ones",
   "description": "The wallet instance shall log all transactions with wallet-relying parties and other wallet units, including electronic signing and sealing, irrespective of whether the transaction completes.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-014",
   "name": "Log integrity, user consent for provider access, and export",
   "description": "The wallet provider shall ensure integrity, authenticity and confidentiality of the transaction log, shall access it only where necessary for the wallet service and on explicit prior consent of the wallet user, and shall enable the wallet user to export it.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-015",
   "name": "No presentation before authentication, policy and approval",
   "description": "The wallet unit shall not present requested attributes until it has verified that the wallet user was authenticated by the secure cryptographic application, that embedded disclosure policies were processed, and that the user approved the presentation in part or in full.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-016",
   "name": "Revocation techniques hinder linkability",
   "description": "Providers of qualified attestations and of public-sector authentic-source attestations shall set up revocation techniques that are privacy preserving and hinder linkability and traceability.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-017",
   "name": "User approval before presenting any attribute",
   "description": "The wallet unit shall ensure that the user approved the presentation of any attribute prior to presenting it, and shall always allow the user to refuse.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-018",
   "name": "Random status list indices and herd privacy",
   "description": "When using an attestation status list, the provider shall randomly assign the index of each attestation and shall represent a sufficiently large number of attestations per list to ensure herd privacy.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-019",
   "name": "Transaction log excludes presented attribute values",
   "description": "For presentation and wallet-to-wallet transactions, the wallet unit shall not store the values of presented attributes in the transaction log.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-020",
   "name": "Intermediary deletes attributes right after forwarding",
   "description": "An intermediary shall delete any attestations and user attributes obtained from the wallet unit completely and immediately after sending the attributes to the intermediated relying party.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-021",
   "name": "Wallet attestations use ECCG agreed cryptographic mechanisms",
   "description": "When issuing, presenting or verifying a wallet instance attestation or key attestation, the participants shall use only cryptographic algorithms included in the ECCG Agreed Cryptographic Mechanisms v2.0.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-022",
   "name": "Token requests name the target MCP server",
   "description": "Where the wallet or an agent acts as an MCP client, the MCP client shall include the resource parameter (RFC 8707) identifying the target MCP server in both authorization requests and token requests.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-023",
   "name": "MCP server validates token audience",
   "description": "Where the wallet or an agent exposes an MCP server, the MCP server shall validate that each access token was issued specifically for it as the intended audience.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-024",
   "name": "No token passthrough by MCP servers",
   "description": "Where the wallet or an agent exposes an MCP server, the MCP server shall not accept or forward any token that was not issued for that server.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-025",
   "name": "Per-client consent in MCP proxy servers",
   "description": "Where the wallet or an agent operates an MCP proxy server in front of a third-party API, the proxy shall keep a per-user registry of approved client IDs and obtain consent for each client before forwarding to the third-party authorization flow.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/security_best_practices"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-026",
   "name": "Explicit consent before one-click local server setup",
   "description": "Where the wallet or an agent supports one-click configuration of local MCP servers, it shall show the exact command without truncation, identify it as a dangerous operation and require explicit user approval before running it.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/security_best_practices"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-027",
   "name": "Least-privilege scopes for agent tokens",
   "description": "Where the wallet or an agent acts as an MCP client, the MCP client shall request only the scopes necessary for the intended operation and elevate incrementally through step-up authorization.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-028",
   "name": "A2A server authenticates every request",
   "description": "Where the wallet or an agent implements A2A as a server, it shall authenticate every incoming request based on the credentials provided and its declared authentication requirements.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-029",
   "name": "A2A authorisation checks on every operation",
   "description": "Where the wallet or an agent implements A2A as a server, it shall perform authorisation checks on every A2A operation and limit results to the authenticated caller's authorised boundaries.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-030",
   "name": "Extended Agent Card requires authentication",
   "description": "Where the wallet or an agent offers an A2A extended Agent Card, it shall require authentication, using a scheme declared in the public card, before returning it.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-031",
   "name": "In-band credentials bound to the originating agent",
   "description": "Where the wallet or an agent passes in-task credentials in-band through a chain of A2A agents, the credentials shall be bound to the agent that originated the request.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-032",
   "name": "Audit trail for sensitive agent operations",
   "description": "Where the wallet or an agent implements A2A, the agent shall keep audit trails for sensitive operations and shall exclude credentials and unneeded personal data from the logs.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-033",
   "name": "Audit logs record principal and agent separately",
   "description": "Where the wallet or an agent acts under delegated authority, the policy enforcement point shall record distinct identifiers for the human or legal-person principal and for the agent instance that performed each action.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-034",
   "name": "Sender-constrained agent tokens",
   "description": "Where the wallet or an agent uses DPoP sender-constrained tokens, the resource server shall ensure that the public key from the DPoP proof matches the key bound to the access token.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc9449"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-035",
   "name": "Every authenticated agent request leaves a trace",
   "description": "Where the wallet or an agent uses workload identity for authentication, each authenticated request shall leave a verifiable and inspectable trace regardless of the authorisation decision.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-wimse-arch/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-036",
   "name": "Agent signing keys protected, hardware-backed where available",
   "description": "Where the wallet or an agent holds a DID authentication key, the key shall be protected against disclosure and shall use hardware-backed storage, an HSM or a secure enclave where available.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://w3c-cg.github.io/ai-agent-protocol/agent-identity.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-037",
   "name": "User keeps full control of wallet use and data",
   "description": "The European Digital Identity Wallet shall leave the user in full control of the use of and of the data in the wallet.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-038",
   "name": "No collection of wallet usage data beyond necessity",
   "description": "The provider of the European Digital Identity Wallet shall not collect information about the use of the wallet which is not necessary for the provision of wallet services.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-039",
   "name": "Logging policy for signing, sealing and notifications",
   "description": "The European Business Wallet provider shall provide a logging policy covering at least electronic signing, electronic sealing and notifications of all transactions, whether or not completed.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-040",
   "name": "Provider access to logs where necessary for the service",
   "description": "The European Business Wallet provider shall access transaction logs only where this is necessary for the provision of the wallet services.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-041",
   "name": "Access events logged with verifiable proofs of authorisation",
   "description": "The European Business Wallet provider shall log and timestamp all access and execution events and bind them to cryptographically verifiable proofs of authorisation suitable for audit and legal proceedings.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-042",
   "name": "Import of owner data from another provider",
   "description": "The European Business Wallet provider shall enable owners to import their exported data to benefit from data portability across wallet providers.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-043",
   "name": "Unlinkability across relying parties",
   "description": "The wallet solution shall enable privacy preserving techniques which ensure unlinkability across different relying parties where the attestation does not require identification of the wallet user.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-044",
   "name": "Cryptographic agility by modular design",
   "description": "The wallet provider shall design wallet and trust-service components so that cryptographic algorithms and parameters can be replaced without redesigning the surrounding protocols or systems.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-045",
   "name": "Agility without in-protocol cipher suite negotiation",
   "description": "The wallet provider shall not rely on run-time cipher suite negotiation as the means of achieving cryptographic agility unless downgrade attacks are demonstrably prevented.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-046",
   "name": "Post-quantum mechanisms combined with classical mechanisms",
   "description": "When the wallet provider deploys post-quantum asymmetric mechanisms, it shall use them in hybrid mode with a classically secure mechanism so that all combined mechanisms must be broken simultaneously to break the hybrid.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://certification.enisa.europa.eu/publications/eucc-guidelines-cryptography_en"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-047",
   "name": "Use recommended cryptographic suites for new signatures and seals",
   "description": "The trust service provider shall use only recommended cryptographic mechanisms and key sizes to generate new signatures and seals, and shall use legacy mechanisms only where needed for interoperability with existing infrastructures.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119300_119399/119312/01.05.01_60/ts_119312v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-048",
   "name": "Audit log time synchronised with UTC daily",
   "description": "The trust service provider shall synchronise the time used to record events in the audit log with UTC at least once a day.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-049",
   "name": "Transaction logs stay accessible as long as law requires",
   "description": "The wallet provider shall keep the transaction logs accessible for as long as they are required by Union or national law.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-050",
   "name": "ERDS signing key in a certified secure cryptographic device",
   "description": "The registered delivery service provider shall hold and use the signing private key within a secure cryptographic device certified to Common Criteria EAL 4 or higher, or, until 31 December 2030, FIPS 140-3 level 3.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1944/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-051",
   "name": "ERDS uses ECCG Agreed Cryptographic Mechanisms",
   "description": "The registered delivery service shall select and use cryptographic techniques in accordance with the Agreed Cryptographic Mechanisms endorsed by the European Cybersecurity Certification Group and published by ENISA.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1944/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-052",
   "name": "Availability of the relying-party register API",
   "description": "The national register of wallet-relying parties shall provide security functions, including security by default and by design, that ensure the availability and integrity of its common API and of the information available through it.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-053",
   "name": "No storage of personal data transmitted via the interconnection",
   "description": "Member States shall ensure that registers, authorities and persons or bodies mandated under national law do not store personal data transmitted through the system of interconnection of registers for the purposes of Articles 13g, 28a and 30a, unless otherwise provided by Union or national law.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-054",
   "name": "Security measures for BRIS communication",
   "description": "Communication and distribution of information via BRIS shall include measures for confidentiality, integrity, non-repudiation of origin and receipt, security event logging, and authentication and authorisation of users and systems.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32021R1042"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-055",
   "name": "Wallet accessible for persons with disabilities",
   "description": "Providers of European Digital Identity Wallets shall make the wallets accessible for use by persons with disabilities on an equal basis with other users, in accordance with Directive (EU) 2019/882.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-056",
   "name": "Business wallet interfaces meet the same accessibility level",
   "description": "The user interfaces of a European Business Wallet for authorised users shall meet at least the accessibility level that applies to European Digital Identity Wallets.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-057",
   "name": "Business wallet accessible for persons with disabilities",
   "description": "Providers of European Business Wallets shall make the European Business Wallets they provide accessible for use by persons with disabilities on an equal basis with other users.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-058",
   "name": "Wallet accessibility measured against EAA Annex I",
   "description": "Providers of European Business Wallets shall provide accessibility for persons with disabilities in accordance with Annex I of Directive (EU) 2019/882, to the extent relevant.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-059",
   "name": "Service information through more than one sensory channel",
   "description": "The service provider shall make the information about the functioning of the service available via more than one sensory channel, present it in an understandable way and make its content available in text formats that can generate alternative assistive formats.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-060",
   "name": "Service websites and apps: perceivable, operable, robust",
   "description": "The service provider shall make the websites, including the related online applications, and the mobile device-based services, including mobile applications, through which a service is provided accessible in a consistent and adequate way by making them perceivable, operable, understandable and robust.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-061/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-061",
   "name": "Support services give accessibility information in accessible modes",
   "description": "Where support services such as help desks, call centres and technical support are available, they shall provide information on the accessibility of the service and its compatibility with assistive technologies in accessible modes of communication.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-062/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-062",
   "name": "Identification and e-signature in consumer flows are accessible",
   "description": "Where identification methods or electronic signatures are provided as part of an e-commerce or consumer banking service, they shall be perceivable, operable, understandable and robust.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/882/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-063/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-063",
   "name": "Wallet web interfaces satisfy WCAG 2.1 Level AA via clause 9",
   "description": "Where a wallet interface is a web page, it shall conform to clauses 9.1 to 9.4 and the conformance requirements of clause 9.6 of EN 301 549 V3.2.1, which is equivalent to WCAG 2.1 Level AA.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-064/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-064",
   "name": "Wallet mobile and desktop apps meet EN 301 549 clause 11",
   "description": "Where a wallet interface is software that is not a web page, it shall conform to the applicable requirements of clause 11 of EN 301 549 V3.2.1, including interoperability with assistive technology and platform user preferences.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-065/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-065",
   "name": "Documents provided by the wallet meet EN 301 549 clause 10",
   "description": "Where a wallet provides downloadable documents that are not web pages, such as receipts, notices or reports, they shall conform to the applicable requirements of clause 10 of EN 301 549 V3.2.1.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-066/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-066",
   "name": "No single biometric as the only authentication means",
   "description": "Where the wallet uses biological characteristics, it shall not rely on a particular biological characteristic as the only means of user identification or for control of the wallet.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-067/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-067",
   "name": "Accessible documentation and support communication",
   "description": "The wallet provider shall make product documentation available in a web format conforming to clause 9 or a non-web format conforming to clause 10 of EN 301 549, and its support services shall accommodate the communication needs of individuals with disabilities directly or through a referral point.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-068/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-068",
   "name": "Wallet units meet Web Accessibility Directive requirements",
   "description": "Wallet Providers shall ensure that their Wallet Units comply with the applicable requirements and standards in the directive on the accessibility of websites and mobile applications of public sector bodies.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-069/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-069",
   "name": "Back-end uses secure cryptographic application and device",
   "description": "The European Business Wallet back-end shall use at least one wallet secure cryptographic application and wallet secure cryptographic device to manage critical assets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-070/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-070",
   "name": "Protected channels between wallet components",
   "description": "The provider of European Business Wallets shall ensure integrity, authenticity and confidentiality of the communication between the wallet back-end, front-end and secure cryptographic applications and device.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-071/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-071",
   "name": "Cryptographic operations only after user authentication",
   "description": "The wallet secure cryptographic applications and devices shall perform cryptographic operations involving critical assets, other than those needed to authenticate the owner, only where they have successfully authenticated the wallet user.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-072/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-072",
   "name": "Secure generation of new cryptographic keys",
   "description": "The wallet secure cryptographic applications and devices shall be able to securely generate new cryptographic keys.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-073/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-073",
   "name": "Secure erasure of critical assets",
   "description": "The wallet secure cryptographic applications and devices shall be able to perform secure erasure of critical assets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-074/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-074",
   "name": "Proof of possession of private keys",
   "description": "The wallet secure cryptographic applications and devices shall be able to generate a proof of possession of private keys.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-075/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-075",
   "name": "Protection of private keys during their lifetime",
   "description": "The wallet secure cryptographic applications and devices shall protect the private keys they generate during the existence of the keys.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-076/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-076",
   "name": "Transaction log records relying party identity",
   "description": "The wallet transaction log shall record the name, contact details and unique identifier of the corresponding relying party and its Member State of establishment, or, for other wallet units, relevant information from the wallet unit attestation.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-077/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-077",
   "name": "Transaction log records data types requested and presented",
   "description": "The wallet transaction log shall record the type or types of data requested and presented in each transaction.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-078/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-078",
   "name": "Transaction log records reason for non-completion",
   "description": "For each non-completed transaction, the wallet transaction log shall record the reason for the non-completion.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-079/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-079",
   "name": "Integrity, authenticity and confidentiality of logs",
   "description": "The provider of European Business Wallets shall ensure integrity, authenticity and confidentiality of the logged information.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-080/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-080",
   "name": "Back-end logs reports sent to competent authorities",
   "description": "The wallet back-end shall log reports sent by the wallet user to competent authorities via the wallet unit, including interactions on notifications, regulatory compliance, data sharing and audit requests.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-081/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-081",
   "name": "Logs accessible for as long as law requires",
   "description": "The wallet logs of transactions shall remain accessible for as long as Union or national law requires them to be accessible.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-082/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-082",
   "name": "Export and portability of owner data at LoA substantial",
   "description": "The European Business Wallet shall support the secure export and portability of the owner's wallet data in at least an open format, so that the owner can migrate to another wallet solution, ensuring a level of assurance of at least substantial.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-083/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-083",
   "name": "Delivery channel provides end-to-end encryption",
   "description": "The Commission shall, by implementing act, ensure that the qualified electronic registered delivery service chosen as the mandatory channel provides end-to-end encryption.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-084/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-084",
   "name": "Credential visibility conditioned on access rights",
   "description": "The provider of European Business Wallets shall ensure that the visibility of credentials and attestations is selective and conditioned on the access rights of the acting subject.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-085/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-085",
   "name": "Only the secure application runs critical-asset operations",
   "description": "The wallet provider shall ensure that the wallet secure cryptographic application is the only component able to execute wallet cryptographic operations and any other operation with critical assets in the context of electronic identification at assurance level high.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-086/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-086",
   "name": "Wallet instance uses a secure cryptographic device",
   "description": "The wallet provider shall ensure that each wallet instance uses at least one wallet secure cryptographic device to manage critical assets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-087/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-087",
   "name": "Protected channel between wallet instance and secure application",
   "description": "The wallet provider shall ensure the integrity, authenticity and confidentiality of the communication between wallet instances and wallet secure cryptographic applications.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-088/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-088",
   "name": "Secure application does not export private keys",
   "description": "The wallet secure cryptographic application shall not enable the export of private keys from the wallet secure cryptographic device.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-089/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-089",
   "name": "Keys protected throughout their lifetime",
   "description": "The wallet secure cryptographic application and device shall protect each private key they generated during the entire lifetime of the key, preventing its extraction in the clear.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-090/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-090",
   "name": "Isolation of assets of different units on a shared device",
   "description": "Where a wallet secure cryptographic application, device or keystore holds cryptographic assets of several wallet units, the wallet provider shall ensure that a wallet unit can access only the assets related to that unit.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-091/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-091",
   "name": "Wallet provider does not read wallet contents",
   "description": "The wallet provider shall not access the contents of a wallet instance, in particular the attestations present, their status, the attribute values and the transaction log.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-092/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-092",
   "name": "Strict access controls for contents hosted at the provider",
   "description": "Where the contents of a wallet unit are stored in a service on the wallet provider back-end, the wallet provider shall specify and implement strict controls that limit its own access to those contents.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-093/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-093",
   "name": "Only the legitimate instance reaches a remote security module",
   "description": "When a remote hardware security module holds critical assets of a wallet unit, the wallet provider shall take measures ensuring that only the legitimate wallet instance can access that module and use those assets.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/main/04-high-level-architecture/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-094/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-094",
   "name": "Remote signing key usable only with consent",
   "description": "The provider of a remote signature creation service shall allow a signing key to be used only in cases for which the signer consent has been obtained.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-095/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-095",
   "name": "Explicit approval by the natural person for a legal-person signer",
   "description": "Where the signer is a legal person and the authentication is linked directly to the identity, the signature activation protocol of a remote signature creation service shall include an explicit action of the natural person, identified during identity verification and allowed to sign in the name of the legal person, to approve the authorisation.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-096/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-096",
   "name": "Signing key generated in a qualified creation device",
   "description": "A qualified provider managing a remote qualified signature or seal creation device shall generate the signing key of the signer in a qualified signature creation device.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-097/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-097",
   "name": "Session limit for identity-based remote signing",
   "description": "Where the authentication is linked directly to the identity, a qualified provider managing a remote qualified creation device shall end the signature session at most 30 minutes after the end of the identity verification process.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-098/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-098",
   "name": "Wallet status lists cover at least 10 000 attestations where possible",
   "description": "The wallet provider shall size its wallet instance attestation status lists, taking account of scale and architecture, so that they are large enough to prevent correlation and, where possible, relate to at least 10 000 attestations.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-099/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-099",
   "name": "Fresh unlinkable index for each instance attestation",
   "description": "Where a wallet provider does not reuse one status index per credential issuer, it shall assign a fresh, unlinkable index value to each wallet instance attestation it issues.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-100/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-100",
   "name": "Instance attestation shown only to issuers",
   "description": "A wallet unit shall present a wallet instance attestation only to a provider of person identification data or an attestation provider as part of issuance, and not to a relying party or any other entity.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-101/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-101",
   "name": "Key attestation shown only to issuers",
   "description": "A wallet unit shall present a key attestation only to a provider of person identification data or an attestation provider as part of issuance of a person identification data or key-bound attestation, and not to a relying party or any other entity.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-102/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-102",
   "name": "Portability stays available during a suspension",
   "description": "Measures taken on the suspension of a wallet solution shall not hinder affected wallet users from exercising their right to data portability, provided this is possible without impairing the security of the critical assets.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-103/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-103",
   "name": "Status index and list address unique per credential",
   "description": "The provider of an mdoc attestation shall ensure that the combination of status index and status list address is unique per mobile security object.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-104/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-104",
   "name": "No authentication to download status lists",
   "description": "A provider of person identification data, an attestation provider or a wallet provider shall not require a relying party to authenticate itself before downloading an attestation status list or attestation revocation list.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-105/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-105",
   "name": "PID validity status published in a privacy-preserving way",
   "description": "Where providers of person identification data revoke person identification data issued to wallet units, they shall make the validity status of the data they issue publicly available in a privacy preserving manner and indicate the location of that information in the data.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-106/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-106",
   "name": "Fresh status list entry for every re-issued token",
   "description": "Where a credential is re-issued, the issuer shall allocate a fresh status list entry to the re-issued credential.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-oauth-status-list/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-107/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-107",
   "name": "Dedicated status entry for each token of a batch",
   "description": "Where credentials are issued in batches for one-time use, the issuer shall give every credential of the batch a dedicated status list entry.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-oauth-status-list/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-108/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-108",
   "name": "No double allocation of status list entries",
   "description": "The status issuer shall prevent any unintended double allocation of a status list address and index to more than one credential.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-oauth-status-list/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-109/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-109",
   "name": "Presentation responses are encrypted",
   "description": "The wallet shall encrypt the authorisation response that carries a presentation to the wallet-relying party.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11947202/01.02.01_60/ts_11947202v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-110/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-110",
   "name": "Wallet attestation does not identify one wallet instance",
   "description": "A wallet attestation presented to an issuer shall not be reused across issuers and shall not carry an identifier specific to a single wallet instance.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/specs/openid4vc-high-assurance-interoperability-profile-1_0.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-111/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-111",
   "name": "Mediating API sees attestation types, not attributes",
   "description": "By default the wallet shall disclose to a mediating operating system or browser interface only the presence of the types of stored attestations, and shall not disclose their attributes or values.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11947202/01.02.01_60/ts_11947202v010201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-112/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-112",
   "name": "Directory processing uses pseudonymisation where appropriate",
   "description": "The Commission shall implement the European Digital Directory in accordance with data protection principles, including, where appropriate, features of pseudonymisation.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-113/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-113",
   "name": "Issuers cannot track use after issuance",
   "description": "The business wallet provider shall ensure that attestation providers and other parties cannot, after issuance, obtain data that allows transactions or user behaviour to be tracked, linked or correlated unless the owner explicitly authorises it.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-114/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-114",
   "name": "List of assets subject to logging",
   "description": "A trust service provider shall establish a list of the assets that are subject to logging, based on the result of its risk assessment, and keep it reviewed.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-115/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-115",
   "name": "Logs kept, backed up and protected for a defined period",
   "description": "A trust service provider shall maintain and back up its logs for a predefined period and shall protect them from unauthorised access or changes.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-116/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-116",
   "name": "Audit events cannot be easily deleted or destroyed",
   "description": "A trust service provider shall log events in a way that they cannot be easily deleted or destroyed during the period in which they are required to be held, except where reliably transferred to long-term media.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.02.01_60/en_319401v030201p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-117/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-117",
   "name": "Creation data protectable against use by others",
   "description": "A qualified electronic signature creation device shall ensure, by appropriate technical and procedural means, that the electronic signature creation data can be reliably protected by the legitimate signatory against use by others.",
   "ebw:category": "NFR",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-118/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-118",
   "name": "Migration object contains no private keys",
   "description": "The migration object of a wallet unit shall not contain private keys of PIDs or device-bound attestations.",
   "ebw:category": "NFR",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-119/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-119",
   "name": "Provider-held keys used only on the authority of the owner",
   "description": "Where a wallet provider holds private keys of an owner in its back-end, the wallet provider shall ensure that those keys are used only on the authorisation of the owner's authorised users and not by the wallet provider itself.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-120/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-120",
   "name": "Log names the authorised user for each signing or sealing",
   "description": "The wallet provider shall record in the transaction log, for each use of a signing or sealing key, the authorised user who triggered it.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-121/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-121",
   "name": "Audit trail records changes to accounts and access rules",
   "description": "The asset interface shall keep, as a minimum, audit events for unauthorised access attempts, changes to identity configuration, changes to accounts of applications and users, and changes to access rules.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://industrialdigitaltwin.io/aas-specifications/IDTA-01004/v3.1/index.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-nfr-122/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-NFR-122",
   "name": "Each auditable event identifies the acting application or machine",
   "description": "Each auditable event of an asset interface shall contain information to determine which application or machine took the action, and the party responsible for the interface shall ensure that this information is sufficient to resolve a dispute about who acted.",
   "ebw:category": "NFR",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://industrialdigitaltwin.io/aas-specifications/IDTA-01004/v3.1/index.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-001",
   "name": "Support and incident reporting mechanism for owners",
   "description": "The provider of European Business Wallets shall provide a mechanism enabling owners to easily request technical support and report technical problems or other incidents having a negative impact on the use of the wallets.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-002",
   "name": "Owner notification and data transfer or deletion on service end",
   "description": "On suspension, revocation or voluntary termination of its services, or removal from the list of notified providers, the provider of European Business Wallets shall notify owners and ensure the transfer or deletion of owner data according to the owner's instructions.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-003",
   "name": "Risk management by non-qualified providers",
   "description": "The non-qualified trust service provider shall have policies and measures to manage legal, business, operational and other risks, including registration and onboarding, procedural checks and service management.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-004",
   "name": "24-hour breach notification by non-qualified providers",
   "description": "The non-qualified trust service provider shall notify the supervisory body and affected individuals of security breaches or disruptions with significant impact without undue delay and no later than 24 hours after becoming aware.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-005",
   "name": "Risk management for qualified services",
   "description": "The qualified trust service provider shall have policies and measures to manage legal, business, operational and other risks, including registration and onboarding, procedural checks and service management.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-006",
   "name": "24-hour security breach notification",
   "description": "The qualified trust service provider shall notify the supervisory body, identifiable affected individuals and other relevant bodies of security breaches or disruptions with significant impact within 24 hours of the incident.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-007",
   "name": "Evidence records kept after cessation",
   "description": "The qualified trust service provider shall record and keep accessible, for as long as necessary after its activities have ceased, all relevant information on data issued and received for evidence and continuity.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-008",
   "name": "Up-to-date termination plan",
   "description": "The qualified trust service provider shall have an up-to-date termination plan to ensure continuity of service.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-009",
   "name": "Notify wallet users within 24 hours of revocation",
   "description": "When a wallet provider has revoked a wallet unit attestation, the wallet provider shall inform the affected wallet user within 24 hours, stating the reason and the consequences, in concise and plain language.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-010",
   "name": "Notify holders within 24 hours of PID revocation",
   "description": "When a provider of person identification data has revoked person identification data, it shall inform the wallet user through a dedicated and secure channel within 24 hours, stating the reasons.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-011",
   "name": "Inventory of cryptographic assets",
   "description": "The wallet provider and each trust service provider shall create and maintain a current inventory of the assets that perform cryptographic operations and of the assets on which cryptographic operations are performed, in a standardised format.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-012",
   "name": "Quantum threat in top-level risk management",
   "description": "The wallet provider and each trust service provider shall include the quantum threat to cryptography in its top-level risk management and classify each use of public-key cryptography as low, medium or high quantum risk.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-013",
   "name": "Security controls for keys, algorithms and devices",
   "description": "The trust service provider shall apply security controls to the management of all cryptographic keys, cryptographic algorithms and cryptographic devices throughout their lifecycle.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-014",
   "name": "Critical vulnerabilities addressed within 48 hours",
   "description": "The trust service provider shall address any critical vulnerability within 48 hours of its discovery.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-015",
   "name": "Records retained for the period stated in the terms and conditions",
   "description": "The trust service provider shall hold records concerning its services for a period appropriate for providing legal evidence and as notified in its terms and conditions.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-016",
   "name": "Restore operations within the continuity plan delay after a disaster",
   "description": "After a disaster, including compromise of a private signing key, the trust service provider shall restore operations within the delay established in its continuity plan and remediate the cause.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-017",
   "name": "Destroy or withdraw private keys on termination",
   "description": "Before the trust service provider terminates its services, it shall destroy or withdraw from use its private keys, including backup copies, so that they cannot be retrieved.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/319401/03.01.01_60/en_319401v030101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-018",
   "name": "Key lifecycle logs retained seven years",
   "description": "The certification service provider shall retain the log of all events relating to the lifecycle of CA-managed keys and the certificate application documentation for at least seven years after any certificate based on these records ceases to be valid.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-019",
   "name": "Documented key generation ceremony with signed report",
   "description": "The certification service provider shall conduct CA key pair generation under a documented ceremony procedure and shall produce a signed report proving that the ceremony followed that procedure and protected the integrity and confidentiality of the key pair.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-020",
   "name": "Inform relying parties of CA key compromise",
   "description": "On compromise, loss or suspected compromise of a CA private key, the certification service provider shall treat it as a disaster, inform all subscribers and relying parties, and indicate that certificates and status information issued with that key may no longer be valid.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-021",
   "name": "Inform parties when an algorithm becomes insufficient",
   "description": "When an algorithm or parameter used by the certification service provider or its subscribers becomes insufficient for its remaining intended usage, the provider shall inform all subscribers and relying parties with whom it has relations and publish that information for other relying parties.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-022",
   "name": "Certification records retained at least five years after expiry",
   "description": "The holder of a wallet solution certificate of conformity shall store the information provided during certification, and specimens of the certified hardware components, securely for at least five years after cancellation or expiry of the certificate.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2981/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-023",
   "name": "Final incident report within one month",
   "description": "The trust service provider shall submit to the CSIRT or competent authority a final incident report not later than one month after submission of the incident notification.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-024",
   "name": "Update cryptographic technology on cryptanalysis developments",
   "description": "Where the wallet provider serves a financial entity, it shall provide for updating or changing cryptographic technology on the basis of developments in cryptanalysis, and shall adopt mitigation and monitoring measures where it cannot update.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-025",
   "name": "Renew certificates in advance of expiry",
   "description": "Where the wallet provider serves a financial entity, it shall renew certificates promptly in advance of their expiration and keep a register of certificates and certificate-storing devices.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-026",
   "name": "Notify users within 24 hours of unit revocation",
   "description": "When the provider of European Business Wallets revokes a wallet unit attestation, it shall inform the affected wallet users without undue delay and no later than 24 hours after the revocation, stating the reason and the consequences, in concise and plain language.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-027",
   "name": "Delivery channel availability, redundancy and fallback",
   "description": "The Commission shall, by implementing act, establish procedures ensuring continuous availability, redundancy and fallback mechanisms for the qualified electronic registered delivery service in case of service failure.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-028",
   "name": "Remote signing key destroyed when its certificate is revoked",
   "description": "The provider of a remote signature creation service shall destroy the signing key when the corresponding public key certificate is revoked.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-029",
   "name": "Remote signing key destroyed on the signer request",
   "description": "The provider of a remote signature creation service shall destroy a signing key when the signer requests it.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-030",
   "name": "Maintain instance revocation status until the stated time",
   "description": "Where a wallet provider signs or seals a wallet instance attestation, it shall maintain the revocation status of the relevant wallet instance until the status expiry indicated in that attestation has passed.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-031",
   "name": "Maintain key storage revocation status until the stated time",
   "description": "Where a wallet provider signs or seals a key attestation, it shall maintain the revocation status of the relevant wallet secure cryptographic device or keystore until the status expiry indicated in that attestation has passed.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-032",
   "name": "Attestations show a status period of at least 31 days",
   "description": "The wallet provider shall ensure that a wallet unit can always present wallet instance attestations and key attestations whose status expiry lies at least 31 days in the future at the time of presentation.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-033",
   "name": "Wallet provider keeps the unit-to-attestation association",
   "description": "The wallet provider shall maintain, for each wallet unit it has activated, the set of instance attestations and key attestations it issued to that unit, so that the association cannot be confused with that of another unit, and shall document the procedures, controls and risk analysis in the policy on unit revocation.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-034",
   "name": "Wallet provider regularly verifies unit security",
   "description": "During the lifetime of a wallet unit, the wallet provider shall regularly verify that the security of the unit is not breached or compromised, and shall revoke the unit where a breach affects its trustworthiness or reliability.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-035",
   "name": "Tell the user of unit revocation outside the unit",
   "description": "The wallet provider shall inform a user about the revocation of the user wallet unit through a communication channel that is independent of the wallet unit.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-036",
   "name": "Revoked PID kept as long as law requires",
   "description": "The provider of person identification data shall keep revoked person identification data accessible for as long as required by Union law or national law.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-037",
   "name": "Revoke a credential when its attribute values change",
   "description": "The provider of a revocable PID or attestation shall revoke it if the value of one or more attributes of the corresponding logical credential changed, and the technical credential is still valid for at least 24 hours.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-038",
   "name": "Trusted list availability of 99,9 percent",
   "description": "The scheme operator of a trusted list shall make the list available 24 hours a day and 7 days a week with an availability of at least 99,9 % over one year.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.04.01_60/ts_119612v020401p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-039",
   "name": "Delivery providers archive the evidence they issue",
   "description": "The provider of an electronic registered delivery service shall archive the evidence or the evidence digests for each evidence it issued.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1944/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-040",
   "name": "Termination plan keeps records accessible and usable",
   "description": "A qualified trust service provider shall ensure that its termination plan specifies procedures that keep all relevant records it holds accessible and usable after termination.",
   "ebw:category": "OPS",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/2530/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-041",
   "name": "Issuers automate mandate revocation and sync with authentic sources",
   "description": "The issuer of a power of attorney or power of representation attestation shall automate revocation and synchronise mandate changes with authentic sources.",
   "ebw:category": "OPS",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-042",
   "name": "Provider states before onboarding what happens to keys on exit",
   "description": "The wallet provider shall state to the owner before onboarding whether the private keys of a wallet unit can be exported or must be re-created when the owner changes provider, and which attestations and certificates must then be re-issued.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-043",
   "name": "Recovery after loss of the key-holding device or module",
   "description": "The wallet provider shall document, for each custody model it offers, how the owner regains the ability to use a wallet unit after loss of the device or module that holds its keys, and which backup copies of keys exist.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-044",
   "name": "Account lifecycle distinguishes temporary deactivation from termination",
   "description": "Where the wallet owner is a financial entity, its identity management shall include a lifecycle process for identities and accounts that covers creation, change, review, temporary deactivation and termination of all accounts.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-045",
   "name": "Withdraw access rights when employment ends or access is no longer necessary",
   "description": "Where the wallet owner is a financial entity, its account management procedures shall provide for the withdrawal of access rights without undue delay upon termination of the employment or when the access is no longer necessary.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-046",
   "name": "Periodic update of access rights",
   "description": "Where the wallet owner is a financial entity, its account management procedures shall provide for the update of access rights where changes are necessary and at least every 6 months for ICT systems supporting critical or important functions, and at least once a year for other ICT systems.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-ops-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-OPS-047",
   "name": "Keep roles and accounts aligned between the identity service and the asset interface",
   "description": "Where a detached service authenticates users or applications and assigns their roles, the party responsible for the asset interface shall ensure that the account information, including roles, is aligned between that service and the interface.",
   "ebw:category": "OPS",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://industrialdigitaltwin.io/aas-specifications/IDTA-01004/v3.1/index.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-trn-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRN-001",
   "name": "Transitional alternative to delivery service until 36 months",
   "description": "Until 36 months after entry into force, a public sector body that does not offer the qualified electronic registered delivery service shall ensure its alternative solutions comply with Regulation (EU) No 910/2014 qualified delivery requirements and offer a gateway to the wallet qualified delivery service.",
   "ebw:category": "TRN",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-trn-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRN-002",
   "name": "No stand-alone quantum-vulnerable mechanisms after 2030",
   "description": "After 31 December 2030 the wallet provider shall not use quantum-vulnerable public-key mechanisms stand-alone for high-risk use cases and shall complete their transition to post-quantum or hybrid mechanisms by then.",
   "ebw:category": "TRN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-trn-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRN-003",
   "name": "Quantum-safe upgrade path with post-quantum signed updates",
   "description": "The wallet provider shall ensure that wallet software that is expected to remain in use beyond 2030 can be upgraded to post-quantum cryptography and that its update mechanism incorporates post-quantum signature schemes for integrity and authenticity.",
   "ebw:category": "TRN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-trn-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRN-004",
   "name": "Plan for post-quantum signature creation devices",
   "description": "The qualified trust service provider shall plan for the availability of certified qualified signature and seal creation devices that support post-quantum algorithms so that its own systems, its customers and conformity assessment can migrate.",
   "ebw:category": "TRN",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ec.europa.eu/newsroom/dae/redirection/document/117507"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-001/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-001",
   "name": "Qualified status before service start",
   "description": "When a provider intends to offer a qualified trust service, the provider shall not begin the service until the qualified status is indicated in the applicable trusted list.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-002/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-002",
   "name": "Trusted lists signed and machine-readable",
   "description": "Member States shall establish, maintain and publish electronically signed or sealed trusted lists in a secured manner and in a form suitable for automated processing.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-003/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-003",
   "name": "Status of a listed service at a given time",
   "description": "A trusted list shall allow a relying party to determine the status of a listed trust service at a given time.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.04.01_60/ts_119612v020401p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-004/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-004",
   "name": "Irreversible revocation of qualified attestations",
   "description": "When a qualified electronic attestation of attributes is revoked, it shall lose its validity and its status shall not be reverted.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-005/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-005",
   "name": "Trust anchors and status checks by relying parties",
   "description": "A relying party instance shall verify the signature over a presented PID, QEAA or PuB-EAA using a trust anchor of the provider obtained from a Trusted List or LoTE.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/main/06-trust-model/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-006/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-006",
   "name": "Invalid wallet provider status",
   "description": "When the status of a wallet provider in the Wallet Provider LoTE is Invalid, PID providers and attestation providers shall refuse to issue PIDs and attestations to wallet units of that wallet provider.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/main/06-trust-model/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-007/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-007",
   "name": "List of notified business wallet providers",
   "description": "The Commission shall publish a machine-readable list of notified European Business Wallet providers that shows whether each provider is a qualified trust service provider.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-008/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-008",
   "name": "Remote onboarding via authorised representative",
   "description": "Providers of European Business Wallets shall ensure that their wallets support common protocols and interfaces to securely onboard the owner remotely via an authorised representative with that representative's electronic identification means of assurance level substantial or high.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-009/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-009",
   "name": "Authentication of relying parties",
   "description": "The European Business Wallet shall support common protocols and interfaces for authenticating relying parties by implementing authentication mechanisms, where authentication is required.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-010/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-010",
   "name": "Relying party verification of wallet authenticity",
   "description": "The European Business Wallet shall support interfaces for relying parties to verify the authenticity and validity of the wallet, where such verification is required.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-011/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-011",
   "name": "Wallet unit attestation with protected keys",
   "description": "Providers of European Business Wallets shall ensure that their wallets support common protocols and interfaces for the provision of wallet unit attestations to all wallet units, containing public keys and corresponding private keys protected by a wallet secure cryptographic device.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-012/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-012",
   "name": "Verifiable and revocable role-attribute mappings",
   "description": "The provider of European Business Wallets shall ensure that mappings between roles and attributes are verifiable, auditable, revocable and traceable to their legitimate issuers.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-013/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-013",
   "name": "Revocation of wallet validity",
   "description": "The provider of European Business Wallets shall ensure that the validity of a wallet can be revoked on explicit owner request, on compromise, on cessation of owner activity, and where the provider is not on the list of notified providers.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-014/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-014",
   "name": "Signed publication of validation mechanisms",
   "description": "The Commission shall make the notified validation mechanism information available to the public through a secure channel, in electronically signed or sealed form suitable for automated processing.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-015/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-015",
   "name": "One set of identification data for third-country operators",
   "description": "A provider of owner identification data shall issue identification data and a unique identifier to an economic operator established outside the Union only if identity proofing meets Article 24(1a) of Regulation (EU) 910/2014 and the operator has not been issued another set.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-016/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-016",
   "name": "Remedy or loss of qualified status",
   "description": "Where the qualified trust service provider fails to remedy a failure to fulfil requirements within the set time limit, the supervisory body shall withdraw the qualified status of the provider or affected service.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-017/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-017",
   "name": "Commission publishes trusted list locations securely",
   "description": "The Commission shall make the notified trusted list information available to the public through a secure channel in electronically signed or sealed form suitable for automated processing.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-018/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-018",
   "name": "Trusted list link when using the EU trust mark",
   "description": "When using the EU trust mark, the qualified trust service provider shall ensure that a link to the relevant trusted list is made available on its website.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-019/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-019",
   "name": "Identity and attribute verification before issuance",
   "description": "When issuing a qualified certificate or qualified electronic attestation of attributes, the qualified trust service provider shall verify the identity and, if applicable, specific attributes of the natural or legal person.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-020/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-020",
   "name": "Permitted identity verification methods",
   "description": "The qualified trust service provider shall verify identity using the European Digital Identity Wallet or a notified high-assurance means, a qualified signature or seal certificate, a conformity-assessed method of high confidence, or physical presence.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-021/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-021",
   "name": "Permitted attribute verification methods",
   "description": "The qualified trust service provider shall verify attributes by wallet or high-assurance means, qualified signature or seal certificate, qualified electronic attestation of attributes, a conformity-assessed method, or physical presence.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-022/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-022",
   "name": "Revocation published within 24 hours",
   "description": "When revoking a qualified certificate, the qualified trust service provider shall register the revocation and publish the revocation status within 24 hours of receiving the request, with immediate effect on publication.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-023/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-023",
   "name": "Free automated validity status information",
   "description": "The qualified trust service provider shall provide relying parties with validity or revocation status per certificate at any time, also beyond validity, in an automated, reliable, free and efficient manner.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-024/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-024",
   "name": "Revocation rules apply to qualified attestations",
   "description": "The qualified trust service provider shall apply the revocation registration, 24-hour publication and status-information rules to qualified electronic attestations of attributes.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-025/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-025",
   "name": "Irreversible revocation of qualified certificates",
   "description": "A qualified certificate for electronic signatures shall lose its validity from the moment of revocation and its status shall not in any circumstances be reverted.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-026/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-026",
   "name": "Irreversible revocation of qualified seal certificates",
   "description": "A qualified certificate for an electronic seal shall lose its validity from the moment of revocation and its status shall not in any circumstances be reverted.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-027/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-027",
   "name": "Notification and publication of issuing public sector bodies",
   "description": "The Member State shall notify issuing public sector bodies with a conformity assessment report to the Commission, which shall publish the list of those bodies signed or sealed and machine-readable.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-028/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-028",
   "name": "Irreversible revocation of public sector attestations",
   "description": "A revoked attestation issued by or for a public sector body responsible for an authentic source shall lose validity from revocation and shall not be reverted.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-029/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-029",
   "name": "Wallet unit attestation signed under a listed certificate",
   "description": "The wallet provider shall issue wallet unit attestations for each wallet unit and shall sign or seal them so that the signatures or seals can be validated by means of a certificate listed in accordance with Implementing Regulation (EU) 2024/2980.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-030/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-030",
   "name": "Only the wallet provider revokes wallet unit attestations",
   "description": "Only the wallet provider that provided a wallet unit shall be capable of revoking that wallet unit attestation, and the provider shall publish a policy on the conditions and timeframe of revocation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-031/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-031",
   "name": "Privacy-preserving publication of wallet unit validity status",
   "description": "When a wallet provider has revoked a wallet unit attestation, the wallet provider shall make the validity status publicly available in a privacy preserving manner and describe its location in the wallet unit attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2979/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-032/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-032",
   "name": "Authenticate relying party access certificates",
   "description": "The wallet unit shall authenticate and validate the wallet-relying party access certificate when interacting with a wallet-relying party.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-033/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-033",
   "name": "Validate and display relying party registration certificate",
   "description": "The wallet unit shall authenticate and validate the wallet-relying party registration certificate, where one is provided, and display its information to the wallet user.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-034/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-034",
   "name": "Request issuance only from certified issuers",
   "description": "The wallet unit shall request issuance of person identification data or attestations only from parties with an authentic and valid wallet-relying party access certificate attesting them as a provider of person identification data or of the relevant type of attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2982/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-035/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-035",
   "name": "PID provider verifies wallet unit attestation before issuance",
   "description": "Before issuing person identification data to a wallet unit, the provider of person identification data shall authenticate and validate the wallet unit attestation and verify that the wallet unit belongs to a wallet solution it accepts, or use another authentication mechanism under an eID scheme notified at assurance level high.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-036/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-036",
   "name": "Public lists of wallet ecosystem actors open without authentication",
   "description": "The Commission shall publish the lists of registrars, registers, wallet providers, PID providers and access certificate providers in signed or sealed machine-readable form and on a human-readable website, without registration or authentication, over state-of-the-art transport encryption.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2980/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-037/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-037",
   "name": "National register of relying parties via signed common API",
   "description": "Member States shall make registered wallet-relying party information available in human-readable and machine-processable form through a single common API and a national website, electronically signed or sealed by or on behalf of the registrar.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-038/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-038",
   "name": "Registration certificates carry a general access policy and privacy URL",
   "description": "Where a Member State authorises registration certificates, the issued certificates shall express each intended use, include a harmonised general access policy limiting requests to the registered data, and contain a URL to the privacy policy for the intended use.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-039/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-039",
   "name": "Published validity and revocation policies for qualified attestations",
   "description": "Providers of qualified attestations and of attestations issued by or on behalf of a public sector body responsible for an authentic source shall have written, publicly accessible policies on validity or revocation status management.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-040/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-040",
   "name": "Mandatory revocation circumstances for attestations over 24 hours",
   "description": "For attestations issued with a validity period of more than 24 hours, the provider shall revoke them upon the holder request, upon known compromise of security or trustworthiness, and in other cases required by law or its policy.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-041/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-041",
   "name": "Authentic and intact status information for relying parties",
   "description": "Providers of qualified attestations and of public-sector authentic-source attestations shall make validity or revocation status available to relying parties in a manner that ensures the integrity and authenticity of the information.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-042/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-042",
   "name": "Qualified registered delivery identifies parties with the wallet",
   "description": "The qualified electronic registered delivery provider shall verify the identity of the recipient with a very high level of confidence and the sender by appropriate means, where either may use the European Digital Identity Wallet remotely.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1944/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-043/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-043",
   "name": "Authenticate relying party in every presentation",
   "description": "The wallet unit and the relying party instance shall perform relying party authentication using an access certificate in all presentation transactions, proximity or remote.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-044/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-044",
   "name": "Accept only notified access certificate trust anchors",
   "description": "For verification of access certificates, the wallet unit shall accept only the trust anchors in the lists of trusted entities of the access certificate authorities notified by Member States.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-045/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-045",
   "name": "Warn when requested attributes exceed registration",
   "description": "After receiving a presentation request, the wallet unit shall verify that all requested attributes are included in the attributes of the registration certificate in the same request and shall warn the user if they are not.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-046/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-046",
   "name": "Wallet checks issuer registration before requesting issuance",
   "description": "Before requesting issuance, the wallet unit shall verify that the attestation type it requests is included in the registration certificate of the PID or attestation provider and shall warn the user if not.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-047/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-047",
   "name": "Relying parties verify revocation status or document a risk analysis",
   "description": "The relying party instance should verify the revocation status of a revocable attestation on receipt, and a relying party that does not shall perform a risk analysis covering the use case.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-048/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-048",
   "name": "MCP client obtains a registered client identifier",
   "description": "Where the wallet or an agent acts as an MCP client with authorization, the MCP client shall obtain a client ID through Client ID Metadata Documents, pre-registration or Dynamic Client Registration before starting the authorization flow.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-049/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-049",
   "name": "Domain-bound client identity via metadata documents",
   "description": "Where the wallet or an agent acts as an MCP client towards authorization servers it does not control, the agent shall support OAuth Client ID Metadata Documents so that its client identity is bound to a domain it controls.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-050/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-050",
   "name": "Server operator identity is not provided by MCP",
   "description": "Where the wallet or an agent exposes an MCP server to counterparties, the wallet provider shall make the identity of the operating legal person verifiable through wallet or trust-list mechanisms, because MCP authorization defines no server-operator identity beyond OAuth endpoints and TLS.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://modelcontextprotocol.io/specification/latest/basic/authorization"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-051/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-051",
   "name": "Wallet-published Agent Cards are signed",
   "description": "Where the wallet or an agent publishes an A2A Agent Card, the publisher shall sign it with a JSON Web Signature so that clients can verify authenticity and integrity.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-052/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-052",
   "name": "Verifier checks Agent Card signature and key status",
   "description": "When the wallet or an agent verifies a signed A2A Agent Card, it shall retrieve the public key via kid and jku or from a trusted key store, verify the signature over the canonicalised card and not use expired or revoked keys.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-053/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-053",
   "name": "Verify a card signature before trusting the card",
   "description": "Where the wallet or an agent consumes an A2A Agent Card to select a counterparty, it shall verify at least one card signature before trusting the card contents.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-054/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-054",
   "name": "Bind agent identity to the legal person outside A2A",
   "description": "Where the wallet or an agent acts for a legal person over A2A, the wallet provider shall bind the agent to the legal person by wallet credentials or equivalent evidence, because A2A leaves identity semantics to the protocol layer.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://a2a-protocol.org/latest/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-055/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-055",
   "name": "Agent identity portable across trust domains",
   "description": "Where the wallet or an agent operates across organisational boundaries, its identity shall be verifiable by a third party that has no visibility into its host environment.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://openid.net/wp-content/uploads/2025/10/Identity-Management-for-Agentic-AI.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-056/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-056",
   "name": "Trust-domain key mapping obtained securely and fresh",
   "description": "Where the wallet or an agent uses workload identity credentials, the mapping from trust domain to trust anchors or JWK Set shall be obtained through a mechanism that ensures its authenticity, integrity and freshness.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-wimse-arch/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-057/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-057",
   "name": "No DID method fallback on failed validation",
   "description": "Where the wallet or an agent authenticates with DID-based agent identity, the verifier shall fail authentication on resolution or validation failure and shall not fall back to another DID method or use an unvalidated DID Document.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://w3c-cg.github.io/ai-agent-protocol/agent-identity.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-058/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-058",
   "name": "Mandate system compatible with digital EU power of attorney",
   "description": "The mandate and authorisation system of a European Business Wallet shall be compatible with the digital EU power of attorney established by Directive (EU) 2025/25.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-059/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-059",
   "name": "Authorisation events bound to verifiable proofs",
   "description": "The provider of European Business Wallets shall ensure that all access and execution events are logged, timestamped and bound to cryptographically verifiable proofs of authorisation suitable for audit and legal proceedings.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-060/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-060",
   "name": "Open mandates bound to the agent's key",
   "description": "A mandate that has not yet been bound to a transaction shall carry the confirmation key of the AI agent authorised to use it.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-061/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-061",
   "name": "Access tokens of agents sender-constrained",
   "description": "An authorisation server shall issue access tokens for AI agents as sender-constrained tokens bound to a key of the agent and shall not issue them as bearer tokens.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc9449"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-062/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-062",
   "name": "Closed mandate bound to the transaction authorised",
   "description": "A closed mandate shall contain a reference that binds it to the specific transaction object it authorises.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://ap2-protocol.org/ap2/specification/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-063/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-063",
   "name": "Derived grants never exceed the source authorisation",
   "description": "When an authorisation server issues a derived token or grant from a presented token, it shall verify that the requested scope is not higher privileged than the scope of the presented token.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://datatracker.ietf.org/doc/draft-ietf-oauth-identity-chaining/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-064/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-064",
   "name": "Credentials alone do not authorise agent actions",
   "description": "A verifier shall not treat possession of a verifiable credential as authorisation of an action without evaluating an accompanying authorisation framework that checks the scope of the delegation.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.w3.org/TR/vc-data-model-2.0/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-065/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-065",
   "name": "Principal-initiated revocation of agent tokens",
   "description": "The authorisation server shall provide a means for the principal side to revoke an access token so that the server invalidates it for all purposes.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.rfc-editor.org/rfc/rfc9635.html"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-066/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-066",
   "name": "Revocation propagated to agent and verifiers",
   "description": "When the owner revokes a mandate, the wallet provider shall make the revocation effective for the AI agent and for verifiers within a defined time, and verifiers shall reject presentations of the revoked mandate.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-067/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-067",
   "name": "Owner identification data bound to the wallet",
   "description": "The European Business Wallet provider shall ensure that the European Business Wallet owner identification data is digitally associated with the European Business Wallet of the owner.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-068/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-068",
   "name": "Attestation issuer verifies the requester right to act",
   "description": "Where applicable, the provider of a qualified or public sector attestation shall verify that the requester of the attestation has the right to act on behalf of the person that is the subject of the attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1569/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-069/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-069",
   "name": "Representation attestations short-lived or revocable",
   "description": "The attestation provider issuing representation attestations shall ensure that either the attestations are short-lived or that all entities entitled by law to request revocation are able to do so.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-070/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-070",
   "name": "Wallet unit access only after substantial-level authentication",
   "description": "The European Business Wallet provider shall grant access to the wallet unit only after the user has been authenticated by a notified eID means or an equivalent alternative mechanism at assurance level substantial or higher.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-071/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-071",
   "name": "Trust anchors stay secure for the whole verification period",
   "description": "The trust service provider shall ensure that a trust anchor remains secure during the whole period in which signatures relying on it need to be verified, and shall apply a maintenance process before the trust anchor becomes insecure.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119300_119399/119312/01.05.01_60/ts_119312v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-072/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-072",
   "name": "Maintenance process for CA, TSU, CRL and OCSP keys",
   "description": "When a CA, time-stamping unit, CRL issuer or OCSP responder key will not remain suitable for its foreseen period, the trust service provider shall apply a maintenance process before the algorithm is broken.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119300_119399/119312/01.05.01_60/ts_119312v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-073/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-073",
   "name": "CA certificate rollover without disruption to relying parties",
   "description": "Before its CA certificate used for signing subject keys expires, the certification service provider that continues the service shall generate a new such certificate and apply all necessary actions to avoid disruption to relying parties.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-074/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-074",
   "name": "Overlap interval between expiry and last certificate signed",
   "description": "The certification service provider shall leave a suitable interval between the expiry date of the old CA certificate and the last certificate it signs, so that subjects, subscribers and relying parties can adapt to the key changeover.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-075/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-075",
   "name": "CA public keys distributed with integrity and origin authentication",
   "description": "The certification service provider shall make its CA signature verification keys available to relying parties in a manner that assures the integrity of the key and authenticates its origin.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-076/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-076",
   "name": "Schedule revocation of certificates using an insufficient algorithm",
   "description": "When an algorithm or parameter becomes insufficient for its remaining intended usage, the certification service provider shall schedule the revocation of every affected certificate.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319400_319499/31941101/01.05.01_60/en_31941101v010501p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-077/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-077",
   "name": "Access certificate status available beyond certificate validity",
   "description": "The provider of wallet-relying party access certificates shall make validity or revocation status available on a per-certificate basis at any time and beyond the validity period of the certificate, automated, reliable and free of charge.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/848/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-078/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-078",
   "name": "Issue owner identification data to the owner wallet",
   "description": "The provider of European Business Wallet owner identification data shall issue the owner identification data to the European Business Wallet of the owner.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-079/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-079",
   "name": "Machine-readable list of notified authentic sources",
   "description": "The Commission shall publish on its website, in a machine-readable format, the list of authentic sources notified by Member States for verifying the attributes required for owner identification data.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-080/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-080",
   "name": "Publish list of recognised third-country wallets",
   "description": "The Commission shall publish on its website a list of the third-country frameworks, business wallets or systems for which it has adopted an equivalence implementing act.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-081/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-081",
   "name": "One set of owner identification data per third-country operator",
   "description": "An economic operator established in a third country shall request only one set of owner identification data from one provider of owner identification data.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-082/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-082",
   "name": "Electronic identification schemes specify assurance levels",
   "description": "A notified electronic identification scheme shall specify assurance levels low, substantial and/or high for the electronic identification means issued under it.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-083/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-083",
   "name": "Wallet provided under an assurance level high scheme",
   "description": "European Digital Identity Wallets shall be provided under an electronic identification scheme with assurance level high.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-084/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-084",
   "name": "Legal person identity proofing at assurance level high",
   "description": "For assurance level high, the entity responsible for registration shall demonstrate the claimed identity of the legal person with its name, legal form and at least one national unique identifier, and shall check the evidence as valid against an authoritative source.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32015R1502"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-085/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-085",
   "name": "Suspend and revoke natural-to-legal person bindings",
   "description": "Where a binding between the electronic identification means of a natural person and of a legal person is used, it shall be possible to suspend and revoke the binding.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32015R1502"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-086/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-086",
   "name": "Owner identification data anchors self-issued attestations",
   "description": "The issuer of an electronic attestation of attributes that is not qualified shall include its owner identification data in the header of every such attestation, and the relying party shall verify it.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-087/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-087",
   "name": "GLN organisation credential links to the GS1 trust chain",
   "description": "The GLN organisation data credential shall reference the matching GS1 company prefix licence credential, directly or through a GLN key credential.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-088/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-088",
   "name": "Recognition of eID means in online company procedures",
   "description": "Member States shall ensure that electronic identification means issued under an approved scheme of their own Member State, or issued in another Member State and recognised for cross-border authentication, can be used by applicants in online company procedures.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-089/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-089",
   "name": "Legal capacity and authority checks in online formation",
   "description": "Member States shall lay down rules on online formation that provide at least for procedures to ensure that applicants have the necessary legal capacity and authority to represent the company.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-090/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-090",
   "name": "Applicants to use trust services in online formation",
   "description": "Member States shall lay down rules on online formation that provide at least for the requirements for applicants to use trust services referred to in Regulation (EU) No 910/2014.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-091/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-091",
   "name": "Identity of persons registering a branch",
   "description": "Member States shall lay down rules on online branch registration that provide at least for the means for verifying the identity of the person or persons registering the branch or their representatives.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-092/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-092",
   "name": "Electronic verification of origin and integrity of filed documents",
   "description": "Member States shall ensure that the origin and integrity of documents filed online can be verified electronically.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-093/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-093",
   "name": "Companies have an EUID",
   "description": "Member States shall ensure that companies listed in Annexes II and IIB have a European unique identifier, the EUID, allowing them to be unequivocally identified in communications between registers through the system of interconnection of registers.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-094/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-094",
   "name": "Registers issue EU Company Certificates accepted in all Member States",
   "description": "Member States shall ensure that the registers issue EU Company Certificates, and that the certificate is accepted in all Member States as sufficient evidence, at the time of issuance, of the incorporation of the company and of the information it lists.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-095/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-095",
   "name": "EU Company Certificate authenticated and wallet-compatible",
   "description": "Member States shall ensure that the EU Company Certificate provided in electronic form is authenticated by means of trust services under Regulation (EU) No 910/2014 and is compatible with the European Digital Identity Wallet.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-096/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-096",
   "name": "Paper EU Company Certificate allows electronic verification of origin",
   "description": "Member States shall ensure that the EU Company Certificate provided in paper form bears a unique protocol or identification number or similar feature that allows the electronic verification of origin and authenticity.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-097/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-097",
   "name": "Verification when granting a digital EU power of attorney",
   "description": "Member States shall ensure that national requirements for drawing up, amending or revoking the digital EU power of attorney include at least the verification by courts, notaries or other competent authorities of the identity, legal capacity and authority to represent the company of the person granting, amending or revoking it.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2025/25/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-098/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-098",
   "name": "Electronic copies and extracts authenticated by trust services",
   "description": "Member States shall ensure that electronic copies and extracts of documents and information provided by the register are authenticated by means of trust services referred to in Regulation (EU) No 910/2014.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/dir/2019/1151/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-099/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-099",
   "name": "EU Inc filings signed by trust services or business wallet",
   "description": "Any documents and information filed via the EU central interface shall be signed by means of trust services referred to in Regulation (EU) No 910/2014 or using the signing function of the European Business Wallet, if applicable.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-100/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-100",
   "name": "EU Inc register filings use eID means or business wallets",
   "description": "All filings of documents and information with the business register shall be fully online and use electronic identification means in accordance with Regulation (EU) No 910/2014 or Business Wallets.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://commission.europa.eu/document/download/3e9822aa-8cef-40a1-904e-a53fc68e7265_en?filename=Proposal+for+an+EU+Inc+corporate+legal+framework.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-101/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-101",
   "name": "Unit attestation generated and signed per wallet unit",
   "description": "The provider of European Business Wallets shall generate and sign a European Business Wallet unit attestation for each European Business Wallet unit.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-102/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-102",
   "name": "Unit attestation signed under a trusted-list certificate",
   "description": "The provider of European Business Wallets shall sign or seal the European Business Wallet unit attestation with a certificate issued under a certificate listed in the trusted list referred to in Commission Implementing Regulation (EU) 2024/2980.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-103/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-103",
   "name": "Unit attestation holds public keys, private keys in secure device",
   "description": "The provider of European Business Wallets shall ensure that each wallet unit attestation contains public keys and that the corresponding private keys are protected by a wallet secure cryptographic device.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-104/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-104",
   "name": "User identification independent of the wallet unit",
   "description": "The provider of European Business Wallets shall provide mechanisms, independent of the wallet units, for the secure identification and authentication of wallet users.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-105/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-105",
   "name": "Public policy on revoking unit attestations",
   "description": "The provider of European Business Wallets shall establish a publicly available policy specifying the conditions and the timeframe for the revocation of wallet unit attestations.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-106/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-106",
   "name": "Public validity status of revoked unit attestations",
   "description": "When the provider of European Business Wallets has revoked a wallet unit attestation, it shall make the validity status of that attestation publicly available and describe the location of that information in the attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-107/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-107",
   "name": "Authenticate relying party for restricted-audience attestations",
   "description": "The European Business Wallet unit shall require authentication of the relying party where an attestation is intended for a restricted audience.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-108/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-108",
   "name": "Wallet unit authenticates issuers before issuance",
   "description": "When a wallet unit requests issuance of electronic attestations of attributes, the provider of European Business Wallets shall ensure the unit is able to authenticate the relying party.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-109/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-109",
   "name": "Present unit attestation to authorities and issuers on request",
   "description": "When the owner interacts through the wallet unit with competent national authorities and attestation providers, the wallet unit shall present its wallet unit attestation upon their request to enable authentication and validation of its components.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-110/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-110",
   "name": "Wallet unit verifies authenticity of received data",
   "description": "The wallet unit shall verify the authenticity and validity of owner identification data and electronic attestations of attributes it receives.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-111/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-111",
   "name": "Owner identification data bound to the receiving unit",
   "description": "Competent national authorities shall ensure that owner identification data they issue is cryptographically bound to the wallet unit to which it is issued.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-112/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-112",
   "name": "Attestation providers identify with relying party access certificate",
   "description": "Providers of electronic attestations of attributes shall identify themselves to wallet units using their wallet-relying party access certificate.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-113/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-113",
   "name": "Security level assigned to every keystore",
   "description": "The wallet provider shall assign a security level to every keystore of a wallet unit, corresponding to the level of resistance for which the keystore was certified.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-114/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-114",
   "name": "Extended identity proofing for remote qualified signers",
   "description": "A qualified provider managing a remote qualified signature or seal creation device shall perform identity proofing of the signer that fulfils the requirements of the extended level of identity proofing defined in ETSI TS 119 461.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11943101/01.03.01_60/ts_11943101v010301p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-115/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-115",
   "name": "Wallet checks that a remote device is part of a qualified service",
   "description": "In remote signature creation scenarios, a wallet unit shall verify that the qualified electronic signature or seal creation device is part of a qualified service carried out by a qualified trust service provider.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-116/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-116",
   "name": "Unit attestation consists of instance and key attestations",
   "description": "A wallet unit attestation shall comprise one or more wallet instance attestations and one or more key attestations.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-117/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-117",
   "name": "Instance attestation expires within 24 hours of the integrity check",
   "description": "The wallet provider shall set the expiry of each wallet instance attestation less than 24 hours after the time at which it verified the integrity of the wallet instance.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-118/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-118",
   "name": "Key attestation states storage and authentication level",
   "description": "A key attestation that mentions a wallet secure cryptographic device shall state the key storage and user authentication level 'iso_18045_high'.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-119/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-119",
   "name": "Separate key attestation per secure device and keystore",
   "description": "The wallet provider shall provide a wallet unit with different key attestations for the wallet secure cryptographic device of the unit and for each of its keystores.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-120/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-120",
   "name": "Sign a key attestation only after verifying key storage",
   "description": "The wallet provider shall sign or seal a key attestation only after verifying that the keys attested are stored in the wallet secure cryptographic device or keystore described in the attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-121/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-121",
   "name": "PID technical validity ends before the status commitments",
   "description": "A provider of person identification data shall end the technical validity period of the data before both the status expiry of the wallet instance attestation and the status expiry of the key attestation received in the issuance process.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-122/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-122",
   "name": "PID provider checks wallet status at least every 24 hours",
   "description": "A provider of person identification data whose data has a technical validity period of more than 24 hours shall, during that period, check the revocation status of the wallet instance attestation and of the key attestation received at issuance at least once every 24 hours, and shall revoke the data where either is revoked.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-123/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-123",
   "name": "Type-shared key status revoked only for a device type vulnerability",
   "description": "Where a wallet provider uses a status index shared by all key attestations of a type of secure device or keystore, it shall revoke that index only if the type has a security vulnerability.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-124/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-124",
   "name": "Revoke all instance status indices of a unit",
   "description": "Where a wallet unit must be revoked, the wallet provider shall revoke the index values in all wallet instance attestations associated with that unit.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-125/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-125",
   "name": "Revoked unit attestations of a withdrawn solution stay revoked",
   "description": "When a Member State withdraws a wallet solution, it shall ensure that the wallet unit attestations of the affected units are revoked, cannot revert to a valid state and that no new unit attestation is issued to existing units of that solution.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/847/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-126/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-126",
   "name": "Status shows only revoked or not revoked",
   "description": "A status element used for person identification data, qualified electronic attestations of attributes or attestations issued by or on behalf of a public sector body responsible for an authentic source shall indicate only whether the attestation is revoked or not revoked and shall not support any other status value, such as suspension.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-127/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-127",
   "name": "Short-lived attestations need no revocation",
   "description": "Revocation of a short-lived electronic attestation of attributes with a validity period of 24 hours or less shall not be required.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-128/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-128",
   "name": "Risk analysis where status information is unavailable",
   "description": "A relying party shall perform a risk analysis considering all relevant factors for the use case to determine whether it accepts or refuses a PID or attestation when no reliable information on its revocation status is available.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-129/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-129",
   "name": "PID revoked when the wallet unit attestation is revoked",
   "description": "A provider of person identification data shall revoke person identification data issued to a wallet unit where the wallet unit attestation of that unit has been revoked.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-130/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-130",
   "name": "PID revoked on the request of the wallet user",
   "description": "A provider of person identification data shall revoke person identification data upon the explicit request of the wallet user to whose wallet unit the data was issued.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-131/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-131",
   "name": "PID revocation cannot be reverted",
   "description": "A provider of person identification data shall ensure that revocations of person identification data cannot be reverted.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2024/2977/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-132/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-132",
   "name": "Suspension of a qualified certificate is visible in status",
   "description": "Where national rules provide for temporary suspension of a qualified certificate, the period of suspension shall be indicated in the certificate database and the suspension status shall be visible during the suspension from the service that gives status information.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-133/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-133",
   "name": "A suspended qualified certificate loses validity",
   "description": "A qualified certificate that has been temporarily suspended under national rules shall lose its validity for the period of suspension.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg/2014/910/2024-10-18/eng/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-134/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-134",
   "name": "Support revocation for owner identification data valid over 24 hours",
   "description": "The provider of owner identification data shall support revocation of owner identification data that has a validity longer than 24 hours.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-135/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-135",
   "name": "Indeterminate status of owner identification data is not valid",
   "description": "A relying party that checks the status of owner identification data shall treat an indeterminate status as not valid, in line with its risk policy.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-136/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-136",
   "name": "A valid unit attestation is required to operate",
   "description": "A European Business Wallet unit shall hold a valid wallet unit attestation in order to operate within the business wallet ecosystem.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://github.com/webuild-consortium/architecture"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-137/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-137",
   "name": "A unit cannot be valid without a valid unit attestation",
   "description": "A European Business Wallet unit shall not be in the state valid unless it holds both a valid wallet unit attestation and valid owner identification data.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://github.com/webuild-consortium/architecture"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-138/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-138",
   "name": "Distribution point in trust tokens resolves to the latest list",
   "description": "Where a trust service provider gives a distribution point for its trusted list in a trust service token, it shall ensure that the distribution point always resolves to the latest applicable trusted list or to a scheme list that points to it.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.04.01_60/ts_119612v020401p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-139/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-139",
   "name": "Authenticate a pointed-to list before using it",
   "description": "A relying party shall authenticate a trusted list or list of trusted entities that another list points to, using one of the digital identities given in the pointer, before it uses the pointed-to list.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119600_119699/119602/01.01.01_60/ts_119602v010101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-140/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-140",
   "name": "Trust evaluation of a delivery service from a trusted list",
   "description": "A party that evaluates trust in an electronic registered delivery service from a trusted list shall validate the service signature, link the signing certificate to the service digital identity in the list, verify that the current status is granted, and verify that the service type fits the applicable trust domain.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_en/319500_319599/3195220403/01.01.01_60/en_3195220403v010101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-141/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-141",
   "name": "Rulebook states how to obtain the trust anchor",
   "description": "The scheme provider of a rulebook for a non-qualified attestation shall specify how a relying party obtains the trust anchor needed to verify the attestation signature.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/main/06-trust-model/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-142/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-142",
   "name": "Verifier can recognise several governance authorities",
   "description": "A verifier in a data space shall be able to recognise the trust anchors of more than one data space governance authority.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eclipse-dataspace-dcp.github.io/decentralized-claims-protocol/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-143/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-143",
   "name": "Signed issuer metadata with the access certificate",
   "description": "A provider of person identification data or electronic attestations of attributes shall publish its issuer metadata as signed metadata, signed with its access certificate.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11947203/01.01.01_60/ts_11947203v010101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-144/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-144",
   "name": "Pre-authorised issuance only with physical presence",
   "description": "A provider of person identification data that uses the pre-authorised code issuance flow shall perform user authorisation with the physical presence of the user.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://www.etsi.org/deliver/etsi_ts/119400_119499/11947203/01.01.01_60/ts_11947203v010101p.pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-145/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-145",
   "name": "Access certificate validation stays in the wallet",
   "description": "The wallet unit shall authenticate and validate wallet-relying party access certificates itself and shall not delegate this to an operating system browser or other intermediary application.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-146/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-146",
   "name": "Preservation evidence carries qualified time stamps",
   "description": "A qualified preservation service shall use qualified time stamps within the preservation evidence.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2025/1946/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-147/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-147",
   "name": "CSP-B performs identity proofing of the participant",
   "description": "The core service provider-B shall verify the identity of the prospective participant through an identity proofing process.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-148/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-148",
   "name": "Every participant has a compliant wallet",
   "description": "Every participant shall have access to a wallet instance complying with the Catena-X wallet requirements after onboarding.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-149/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-149",
   "name": "CSP-B issues membership, BPN and framework credentials",
   "description": "The core service provider-B shall issue to the prospective participant a Membership Credential, a BPN Credential and a Framework Agreement Credential, provided that the conditions for the credential claims are met.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0006-RegistrationAndInitialOnboarding"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-150/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-150",
   "name": "CSP triggers the clearing house trust anchor",
   "description": "The core service provider shall be able to trigger the clearing house trust anchor for a registration application.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0009-CXRegistrationAPI"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-151/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-151",
   "name": "Wallets in the data space are compliant",
   "description": "Any wallet used in the Catena-X data space shall be a Catena-X-compliant wallet.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0149-WalletRequirements"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-152/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-152",
   "name": "Membership Credential issued by CSP or assigned issuer",
   "description": "The core service provider, or an issuer assigned by it, shall issue the Membership Credential to the participant.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0050-CXSpecificCredentials/CX-0050-CatenaXSpecificVerifiableCredentials"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-153/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-153",
   "name": "BPN-DID resolution checks the Membership Credential",
   "description": "The BPN-DID resolution service shall check the validity of the provided Membership Credential, including type, expiry, revocation and a signature by a trusted issuer, and deny access if the check fails.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0167-BpnDidResolution"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-154/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-154",
   "name": "Catalogue request token scope covers membership, BPN and framework credentials",
   "description": "The token for requesting a catalogue shall include a scope covering the Membership Credential, the BPN Credential and the Framework Agreement Credential.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0018-DataspaceConnectivity"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-155/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-155",
   "name": "BPN access constraints validated through credentials",
   "description": "Data providers and data consumers shall validate access policy constraints on the BPN or on BPNLs of a business partner group through the Membership Credential or the BPN Credential.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0152-PolicyConstrainsForDataExchange"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-156/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-156",
   "name": "Managing relation only after power of attorney is verified",
   "description": "The core service provider-B shall create an \"is managed by\" relation between legal entities only after it has verified that the managing legal entity has legal authority or power of attorney for the managed legal entity.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-157/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-157",
   "name": "Confidence level for BPNL and BPNA",
   "description": "The service provider shall calculate and assign a confidence level to BPNLs and BPNAs to indicate data quality.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://catenax-ev.github.io/docs/next/standards/CX-0076-GoldenRecordEndtoEndRequirementsStandard"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-158/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-158",
   "name": "Wallet provider verifies wallet instance integrity and signs the instance attestation",
   "description": "The wallet provider shall verify the integrity of the wallet instance and sign or seal the wallet instance attestation.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_impl/2026/1731/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-159/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-159",
   "name": "Suspended mandate attestation treated as invalid",
   "description": "Where a power of attorney or power of representation attestation is suspended, the relying party shall treat it as invalid for as long as the suspension lasts.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-160/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-160",
   "name": "Reject mandate attestations that are not active",
   "description": "A relying party shall reject every power of attorney or power of representation attestation whose status is not active, including revoked, expired and unknown.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-161/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-161",
   "name": "Verify identifier, status, validity and issuer before accepting a mandate",
   "description": "Before accepting a power of attorney or power of representation attestation, the relying party shall verify the attestation identifier, its current status, its validity period and the status of its issuer.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-162/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-162",
   "name": "Revoke a mandate attestation when the principal withdraws the mandate",
   "description": "The issuer of a power of attorney or power of representation attestation shall revoke it when the principal withdraws the mandate.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-163/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-163",
   "name": "Revoke a mandate attestation when the representative leaves the organisation",
   "description": "The issuer of a power of attorney or power of representation attestation shall revoke it when the representative leaves the organisation.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-164/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-164",
   "name": "Revoke mandate attestations when the company is dissolved",
   "description": "The issuer of a power of attorney or power of representation attestation shall revoke it when the represented company is dissolved.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-165/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-165",
   "name": "Authenticate the requester before accepting a unit revocation request",
   "description": "The provider of European Business Wallets shall authenticate the person who requests revocation of a wallet unit before accepting the request.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eudi.dev/latest/annexes/annex-2/annex-2.02-high-level-requirements-by-topic/"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-166/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-166",
   "name": "Revoked owner identification data leaves the structural trust of the unit intact",
   "description": "When the owner identification data of a European Business Wallet unit is revoked or expires, the unit shall lose its identity validity while its wallet unit attestation stays valid.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://github.com/webuild-consortium/architecture"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-167/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-167",
   "name": "Actions outside the mandate scope are rejected",
   "description": "A relying party shall reject an action that falls outside the scope defined in the mandate of the acting representative.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-168/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-168",
   "name": "Joint representation requires two or more signatories acting together",
   "description": "Where the representation type of the authorised signatories of a legal entity is joint, a relying party that verifies the authorised signatories attestation shall require that two or more signatories act together before it treats an act as made on behalf of the entity.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-169/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-169",
   "name": "Custody model recorded per private key",
   "description": "The wallet provider shall record for each private key of a wallet unit the custody model that holds it (device held by the owner, module operated by the provider, module operated by the owner, or remote service of a qualified trust service provider) and shall make the record available to the owner on request.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:52025PC0838"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-170/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-170",
   "name": "Council text: onboarding of the owner at assurance level high",
   "description": "Providers of European Business Wallets shall ensure that their wallets support common protocols and interfaces to securely onboard the owner remotely via a legal representative or other lawfully empowered person with an electronic identification means that meets assurance level high.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-171/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-171",
   "name": "Identity proofing covers the representative of a third-country operator",
   "description": "A provider of owner identification data shall issue owner identification data and a unique identifier to an economic operator established outside the Union only if the identity proofing of the operator and of its representative empowered to carry out the onboarding fulfils the identity verification methods of Article 24(1a) of Regulation (EU) No 910/2014.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://data.consilium.europa.eu/doc/document/ST-9684-2026-INIT/en/pdf"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-172/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-172",
   "name": "Legal person not in a status that prevents it from acting",
   "description": "For identity proofing of a legal person at assurance level high, the entity responsible for registration shall check that the legal person is not known by an authoritative source to be in a status that would prevent it from acting as that legal person.",
   "ebw:category": "TRU",
   "ebw:provenance": "L",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://publications.europa.eu/resource/celex/32015R1502"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-173/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-173",
   "name": "Issuer establishes the principal's authority before issuing a power of attorney",
   "description": "The issuer of an EU power of attorney attestation shall reject the issuance if the authority of the principal to act on behalf of the company cannot be established.",
   "ebw:category": "TRU",
   "ebw:provenance": "S",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-174/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-174",
   "name": "Reject acts of a substitute where substitution is not allowed",
   "description": "Where an EU power of attorney attestation states that substitution is not allowed, a relying party shall reject an act that a third party performs under powers the attorney has passed on.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": []
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-175/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-175",
   "name": "Unique identification and authentication of systems as well as persons",
   "description": "Where the wallet owner is a financial entity, its identity management policies and procedures shall ensure the unique identification and authentication of natural persons and systems accessing its information.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj"
    }
   ]
  },
  {
   "@id": "https://spherity.github.io/business-wallet-requirements/requirements/ebw-tru-176/",
   "@type": [
    "ebw:Requirement",
    "DefinedTerm"
   ],
   "identifier": "EBW-TRU-176",
   "name": "Authenticate the calling machine or application before granting access",
   "description": "Before granting an application or machine access to protected asset data or restricted services, the party operating the asset interface shall identify and authenticate that application.",
   "ebw:category": "TRU",
   "ebw:provenance": "D",
   "ebw:status": "draft",
   "ebw:derivedFrom": [
    {
     "@id": "https://industrialdigitaltwin.io/aas-specifications/IDTA-01004/v3.1/index.html"
    }
   ]
  },
  {
